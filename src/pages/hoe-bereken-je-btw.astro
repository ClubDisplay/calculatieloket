---
import BtwCalculatorPage from "../components/calculator/BtwCalculatorPage.astro";

const title = "Hoe bereken je btw? — Formule en voorbeelden | Calculatieloket.nl";
const description = "Leer hoe je btw berekent inclusief en exclusief. Met formules, voorbeelden en een gratis rekenmachine. Gebaseerd op de Belastingdienst.";

const sources = [
  {
    label: "Officiële bron",
    title: "Belastingdienst — BTW-tarieven",
    description: "Actuele btw-tarieven: 21%, 9% en 0%.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/btw_berekenen_aan_uw_klanten/btw_berekenen/btw_tarief/btw_tarief",
  },
  {
    label: "Officiële bron",
    title: "Belastingdienst — Rekenvoorbeeld btw berekenen",
    description: "Voorbeelden van btw berekenen inclusief en exclusief.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/btw_berekenen_aan_uw_klanten/btw_berekenen/rekenvoorbeeld_btw_berekenen",
  },
];

const faq = [
  {
    question: "Hoe bereken je btw over een bedrag?",
    answer: "Vermenigvuldig het exclusieve bedrag met het btw-percentage gedeeld door 100. Bij 21%: bedrag × 0,21. Bij 9%: bedrag × 0,09. Tel het btw-bedrag op bij het exclusieve bedrag voor het totaal inclusief.",
  },
  {
    question: "Hoe reken je inclusief btw om naar exclusief?",
    answer: "Deel het inclusieve bedrag door (1 + het percentage). Bij 21%: bedrag ÷ 1,21. Bij 9%: bedrag ÷ 1,09. Het btw-bedrag is het verschil tussen inclusief en exclusief.",
  },
  {
    question: "Wat is de formule voor btw?",
    answer: "Exclusief → inclusief: inclusief = exclusief × (1 + tarief). Inclusief → exclusief: exclusief = inclusief ÷ (1 + tarief). Btw-bedrag = inclusief − exclusief.",
  },
  {
    question: "Welke btw-tarieven gelden er in Nederland?",
    answer: "Nederland kent drie tarieven: 21% (hoog tarief), 9% (laag tarief) en 0% (nultarief). Het 21%-tarief geldt voor de meeste producten en diensten.",
  },
  {
    question: "Hoe reken je € 100 exclusief om naar inclusief 21%?",
    answer: "€ 100 × 1,21 = € 121. Het btw-bedrag is € 21.",
  },
  {
    question: "Kan ik deze berekening gebruiken voor mijn btw-aangifte?",
    answer: "De uitkomst is een indicatie. Gebruik de berekening als hulpmiddel, maar controleer belangrijke bedragen voor je administratie of btw-aangifte via officiële bronnen of een adviseur.",
  },
];

const useCases = [
  {
    id: "btw-21-procent",
    title: "BTW 21% berekenen",
    description: "Bereken direct het hoge tarief voor je product of dienst.",
    template: "Bereken {{bedrag}} met 21% btw.",
    href: "/btw-21-procent-berekenen/",
    accent: "#2563eb",
  },
  {
    id: "btw-9-procent",
    title: "BTW 9% berekenen",
    description: "Bereken direct het lage tarief voor levensmiddelen en boeken.",
    template: "Bereken {{bedrag}} met 9% btw.",
    href: "/btw-9-procent-berekenen/",
    accent: "#3b82f6",
  },
  {
    id: "terugrekenen",
    title: "BTW terugrekenen",
    description: "Reken een inclusief bedrag om naar exclusief.",
    template: "Reken {{incl}} inclusief btw terug naar {{excl}} exclusief.",
    href: "/btw-terugrekenen/",
    accent: "#2563eb",
  },
  {
    id: "inclusief-exclusief",
    title: "BTW inclusief/exclusief",
    description: "Wissel in beide richtingen tussen exclusief en inclusief.",
    template: "Reken {{bedrag}} om tussen exclusief en inclusief btw.",
    href: "/btw-inclusief-exclusief/",
    accent: "#3b82f6",
  },
];

const crossSell = [
  { href: "/btw-21-procent-berekenen/", title: "BTW 21%", description: "Bereken het hoge btw-tarief.", accent: "#2563eb" },
  { href: "/btw-9-procent-berekenen/", title: "BTW 9%", description: "Bereken het lage btw-tarief.", accent: "#3b82f6" },
  { href: "/zzp-calculator/", title: "ZZP Calculator", description: "Reken je uurtarief als ondernemer.", accent: "#7c3aed" },
];

const relatedLinks = [
  { href: "/btw-calculator/", label: "BTW calculator" },
  { href: "/btw-21-procent-berekenen/", label: "BTW 21 procent berekenen" },
  { href: "/btw-9-procent-berekenen/", label: "BTW 9 procent berekenen" },
  { href: "/btw-terugrekenen/", label: "BTW terugrekenen" },
  { href: "/btw-inclusief-exclusief/", label: "BTW inclusief/exclusief" },
];

const content = `
<h2>De basisformule voor btw</h2>
<p>Btw berekenen is wiskunde die je in twee richtingen kunt toepassen:</p>
<div class="formula-box">
  <p><strong>Exclusief → inclusief:</strong> inclusief = exclusief &times; (1 + tarief)</p>
  <p><strong>Inclusief → exclusief:</strong> exclusief = inclusief &divide; (1 + tarief)</p>
  <p><strong>Btw-bedrag:</strong> btw = inclusief &minus; exclusief</p>
</div>
<p>Gebruik de rekenmachine hierboven om direct uit te proberen. Kies 21%, 9% of 0% en kies de richting.</p>

<h2>BTW berekenen in 3 stappen</h2>
<ol class="calc-list">
  <li><strong>Bepaal het bedrag:</strong> weet je exclusief of inclusief bedrag?</li>
  <li><strong>Kies het tarief:</strong> 21%, 9% of 0%?</li>
  <li><strong>Toepassen:</strong> vermenigvuldig met (1 + tarief) of deel door (1 + tarief).</li>
</ol>

<h2>Voorbeelden</h2>
<table class="rate-table">
  <thead>
    <tr><th>Tarief</th><th>Exclusief</th><th>Btw-bedrag</th><th>Inclusief</th></tr>
  </thead>
  <tbody>
    <tr><td>21%</td><td>&euro; 100</td><td>&euro; 21</td><td>&euro; 121</td></tr>
    <tr><td>21%</td><td>&euro; 250</td><td>&euro; 52,50</td><td>&euro; 302,50</td></tr>
    <tr><td>9%</td><td>&euro; 100</td><td>&euro; 9</td><td>&euro; 109</td></tr>
    <tr><td>9%</td><td>&euro; 250</td><td>&euro; 22,50</td><td>&euro; 272,50</td></tr>
  </tbody>
</table>

<h2>Wanneer gebruik je welk tarief?</h2>
<ul class="calc-list">
  <li><strong>21%:</strong> de meeste goederen en diensten.</li>
  <li><strong>9%:</strong> levensmiddelen, water, boeken, medicijnen, kunst, bepaald vervoer.</li>
  <li><strong>0%:</strong> specifieke situaties zoals export naar EU-landen. Let op: dit is iets anders dan een vrijstelling.</li>
</ul>

<h2>Veelgemaakte fouten</h2>
<ul class="calc-list">
  <li><strong>Percentage van inclusief bedrag aftrekken:</strong> dat geeft een verkeerd antwoord. Deel altijd door (1 + tarief).</li>
  <li><strong>0% en vrijgesteld verwarren:</strong> bij 0% vermeld je 0% op de factuur; bij vrijgesteld vermeld je geen btw.</li>
  <li><strong>Tarief verkeerd toepassen:</strong> niet alles in de supermarkt valt onder 9%. Sommige luxe artikelen hebben 21%.</li>
</ul>

<h2>Meer tools</h2>
<p>Wil je een specifiek tarief of een specifieke richting? Gebruik dan een van de andere btw-pagina’s. Ondernemers kunnen hun <a href="/zzp-calculator/">ZZP uurtarief</a> berekenen.</p>
`;
---

<BtwCalculatorPage
  title={title}
  description={description}
  pageTitle="Hoe bereken je btw?"
  calculatorId="hoe-bereken-je-btw"
  defaultAmount={100}
  defaultRate={21}
  defaultDirection="excl"
  allowRateSwitch={true}
  allowDirectionSwitch={true}
  intro={[
    "Leer hoe je btw berekent inclusief en exclusief. Met formules, voorbeelden en een gratis rekenmachine.",
    "Btw berekenen lijkt simpel, maar er zit een valkuil in: je moet weten of je van exclusief naar inclusief rekent, of andersom. Op deze pagina leggen we het uit en kun je direct oefenen.",
  ]}
  content={content}
  faq={faq}
  useCases={useCases}
  crossSell={crossSell}
  relatedLinks={relatedLinks}
  howTo={{
    name: "BTW berekenen",
    description: "Stappen om btw te berekenen inclusief en exclusief.",
    steps: [
      { name: "Bepaal het bedrag", text: "Voer het bedrag in waarover je btw wilt berekenen." },
      { name: "Kies het tarief", text: "Selecteer 21%, 9% of 0% btw." },
      { name: "Kies de richting", text: "Bereken exclusief naar inclusief, of inclusief naar exclusief." },
      { name: "Bekijk het resultaat", text: "De calculator toont het exclusieve bedrag, het btw-bedrag en het inclusieve bedrag." },
    ],
  }}
  sources={sources}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Belasting", href: "/categorie/belasting/" },
    { label: "Hoe bereken je btw?", current: true },
  ]}
  footerDisclaimer="Deze uitkomst is een indicatie op basis van je invoer en de btw-tarieven van 2026. Controleer belangrijke bedragen via officiële bronnen of een adviseur. Aan de uitkomst kunnen geen rechten worden ontleend."
/>
