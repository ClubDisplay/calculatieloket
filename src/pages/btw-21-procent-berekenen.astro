---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AdSlot from "../components/AdSlot.astro";
import CrossSellCards from "../components/CrossSellCards.astro";
import CalculatorShell from "../components/calculator/CalculatorShell.astro";
import InputPanel from "../components/calculator/InputPanel.astro";
import ResultPanel from "../components/calculator/ResultPanel.astro";
import UseCasesPanel from "../components/calculator/UseCasesPanel.astro";
import FaqAccordion from "../components/calculator/FaqAccordion.astro";
import ToolFooter from "../components/calculator/ToolFooter.astro";
import SourceCards from "../components/SourceCards.astro";
import TrustPanel from "../components/calculator/TrustPanel.astro";
import FinancialJourney from "../components/calculator/FinancialJourney.astro";
import HowToSchema from "../components/calculator/HowToSchema.astro";
import InlineSources from "../components/calculator/InlineSources.astro";
import { calculateBtw } from "../lib/calculators/btw";
import { getRecommendations } from "../lib/recommendations/engine";
import { formatEuro } from "../lib/format/currency";

const title = "BTW 21 procent berekenen — Hoog tarief | Calculatieloket.nl";
const description = "Bereken 21% btw over elk bedrag. Zie direct exclusief, btw-bedrag en inclusief. Gebaseerd op het hoge btw-tarief van de Belastingdienst.";

const defaultAmount = 100;
const defaultRate = 21;
const defaultDirection: "excl" | "incl" = "excl";

const initialResult = calculateBtw({
  amount: defaultAmount,
  rate: defaultRate,
  direction: defaultDirection === "excl" ? "exclusive_to_inclusive" : "inclusive_to_exclusive",
});

const initialRecommendations = getRecommendations({
  calculator: "btw-21-procent",
  values: { amount: defaultAmount, rate: defaultRate, direction: defaultDirection },
  result: initialResult,
});

const heroLabel = defaultDirection === "excl" ? "Bedrag inclusief 21% btw" : "Bedrag exclusief 21% btw";
const heroValue = formatEuro(defaultDirection === "excl" ? initialResult.amountIncl : initialResult.amountExcl, 2);
const heroSubtext = defaultDirection === "excl"
  ? `Dit wordt ${formatEuro(initialResult.amountIncl, 2)} inclusief 21% btw over ${formatEuro(initialResult.amountExcl, 2)} exclusief.`
  : `Dit is ${formatEuro(initialResult.amountExcl, 2)} exclusief btw van ${formatEuro(initialResult.amountIncl, 2)} inclusief.`;

const lastUpdated = "27 juli 2026";

const quickAmounts = [50, 100, 250, 500, 1000];

const useCases = [
  {
    id: "btw-9-procent",
    title: "BTW 9% berekenen",
    description: "Bereken het lage btw-tarief voor producten zoals levensmiddelen.",
    template: "Vergelijk {{incl}} inclusief 21% met het 9% tarief.",
    href: "/btw-9-procent-berekenen/",
    accent: "#3b82f6",
  },
  {
    id: "terugrekenen",
    title: "BTW terugrekenen",
    description: "Reken een inclusief bedrag om naar exclusief btw.",
    template: "Reken {{incl}} inclusief 21% btw terug naar {{excl}} exclusief.",
    href: "/btw-terugrekenen/",
    accent: "#2563eb",
  },
  {
    id: "inclusief-exclusief",
    title: "BTW inclusief/exclusief",
    description: "Reken bedragen om tussen exclusief en inclusief.",
    template: "Reken {{bedrag}} om tussen exclusief en inclusief btw.",
    href: "/btw-inclusief-exclusief/",
    accent: "#3b82f6",
  },
  {
    id: "zzp",
    title: "ZZP uurtarief",
    description: "Bereken je benodigde uurtarief als ZZP'er.",
    href: "/zzp-calculator/",
    accent: "#7c3aed",
  },
];

const sources = [
  {
    label: "Officiële bron",
    title: "Belastingdienst — BTW-tarieven",
    description: "Actuele btw-tarieven: 21%, 9% en 0%.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/btw_berekenen_aan_uw_klanten/btw_berekenen/btw_tarief/btw_tarief",
  },
  {
    label: "Officiële bron",
    title: "Belastingdienst — Rekenvoorbeeld btw berekenen",
    description: "Voorbeelden van btw berekenen inclusief en exclusief.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/btw_berekenen_aan_uw_klanten/btw_berekenen/rekenvoorbeeld_btw_berekenen",
  },
];

const faq = [
  {
    question: "Hoe bereken je 21% btw over een bedrag?",
    answer: "Vermenigvuldig het exclusieve bedrag met 0,21. Het totaal inclusief btw is het exclusieve bedrag × 1,21. Wil je van inclusief naar exclusief, deel dan door 1,21.",
  },
  {
    question: "Wanneer gebruik je 21% btw?",
    answer: "21% is het algemene hoge tarief. Het geldt voor de meeste goederen en diensten, zoals elektronica, kleding, horeca, consultancy en reparaties.",
  },
  {
    question: "Hoe reken je € 100 exclusief om naar inclusief 21% btw?",
    answer: "€ 100 × 1,21 = € 121. Het btw-bedrag is € 21.",
  },
  {
    question: "Hoe haal je 21% btw van een totaalbedrag af?",
    answer: "Deel het inclusieve bedrag door 1,21. Bij € 121 is dat € 100 exclusief. Het btw-bedrag is € 121 − € 100 = € 21.",
  },
  {
    question: "Is 21% btw hetzelfde als 21% van het inclusieve bedrag?",
    answer: "Nee. 21% btw is berekend over het exclusieve bedrag. 21% van het inclusieve bedrag zou meer zijn dan het werkelijke btw-bedrag. Daarom deel je bij terugrekenen door 1,21.",
  },
  {
    question: "Kan ik deze berekening gebruiken voor mijn btw-aangifte?",
    answer: "De uitkomst is een indicatie. Gebruik de berekening als hulpmiddel, maar controleer belangrijke bedragen voor je administratie of btw-aangifte via officiële bronnen of een adviseur.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://calculatieloket.nl/",
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Belasting",
      "item": "https://calculatieloket.nl/categorie/belasting/",
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "BTW 21 procent berekenen",
      "item": "https://calculatieloket.nl/btw-21-procent-berekenen/",
    },
  ],
};
---

<BaseLayout title={title} description={description} containerClass="container-wide">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <HowToSchema
    slot="head"
    name="21% btw berekenen"
    description="Stappen om 21% btw te berekenen over een bedrag."
    totalTime="PT30S"
    steps={[
      { name: "Vul het bedrag in", text: "Voer het bedrag in waarover je 21% btw wilt berekenen." },
      { name: "Kies de richting", text: "Kies of je van exclusief naar inclusief wilt rekenen, of andersom." },
      { name: "Bekijk het resultaat", text: "De calculator toont het bedrag exclusief, het btw-bedrag en het bedrag inclusief." },
    ]}
  />

  <AdSlot slot="1234567890" format="auto" style="min-height:100px" />

  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "Belasting", href: "/categorie/belasting/" },
    { label: "BTW 21 procent berekenen", current: true },
  ]} />

  <CalculatorShell title="BTW 21 procent berekenen" subtitle="Reken direct 21% btw uit. Kies exclusief naar inclusief of inclusief naar exclusief.">
    <InputPanel title="Jouw bedrag" slot="input">
      <div class="form-group">
        <label for="amount">Bedrag</label>
        <div class="input-prefix">
          <span class="prefix">&euro;</span>
          <input type="number" id="amount" value={defaultAmount} min="0" step="0.01" />
        </div>
      </div>

      <div class="quick-chips" role="group" aria-labelledby="quickChipsLabel">
        <span class="quick-chips-label" id="quickChipsLabel">Snel kiezen:</span>
        {quickAmounts.map((amount) => (
          <button type="button" class="quick-chip" data-amount={amount} data-analytics="quick-chip" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label={amount}>
            &euro; {amount.toLocaleString("nl-NL")}
          </button>
        ))}
      </div>

      <div class="form-group">
        <label>BTW-tarief</label>
        <div class="radio-group radio-group-fixed" role="group" aria-label="BTW-tarief">
          <button type="button" class="active" aria-pressed="true" data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="rate-21">21%</button>
        </div>
        <p class="btw-nul-waarschuwing">Het hoge tarief van 21% geldt voor de meeste producten en diensten.</p>
      </div>

      <div class="form-group">
        <label>Bereken</label>
        <div class="radio-group" id="btwDirection" role="group" aria-label="Berekenrichting">
          <button type="button" data-direction="excl" class={defaultDirection === "excl" ? "active" : ""} aria-pressed={defaultDirection === "excl" ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="direction-excl">Exclusief &rarr; inclusief</button>
          <button type="button" data-direction="incl" class={defaultDirection === "incl" ? "active" : ""} aria-pressed={defaultDirection === "incl" ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="direction-incl">Inclusief &rarr; exclusief</button>
        </div>
      </div>

      <p class="calc-live-status" aria-live="polite">Resultaat wordt automatisch bijgewerkt.</p>
      <p class="calc-error" id="calcError" style="display:none;">Vul een geldig bedrag in (0 of hoger).</p>
    </InputPanel>

    <ResultPanel
      slot="result"
      title="21% btw resultaat"
      heroLabel={heroLabel}
      heroValue={heroValue}
      heroSubtext={heroSubtext}
      badge="Indicatie"
    >
      <div class="result-meta">
        <span class="meta-badge">Bijgewerkt: 2026</span>
        <span class="meta-badge">Bron: Belastingdienst</span>
      </div>

      <div class="result-row"><span class="label">Bedrag exclusief btw</span><span class="value" id="detailExcl">{formatEuro(initialResult.amountExcl, 2)}</span></div>
      <div class="result-row"><span class="label">Btw-bedrag</span><span class="value" id="detailBtw">{formatEuro(initialResult.btwAmount, 2)}</span></div>
      <div class="result-row"><span class="label">Bedrag inclusief btw</span><span class="value" id="detailIncl">{formatEuro(initialResult.amountIncl, 2)}</span></div>
      <div class="result-divider"></div>
      <div class="result-row"><span class="label">Gebruikt tarief</span><span class="value" id="detailRate">21% btw</span></div>

      <FinancialJourney recommendations={initialRecommendations} />
      <InlineSources title="Gebruikte bronnen" items={sources} />

      <button class="copy-link-btn" id="copyLinkBtn" type="button" slot="actions" data-analytics="copy-link" data-analytics-category="calculator-page" data-analytics-action="click" data-analytics-label="copy-link" aria-label="Deel deze berekening">
        <span class="copy-link-icon" aria-hidden="true">🔗</span>
        <span class="copy-link-text">Deel deze berekening</span>
      </button>
    </ResultPanel>

    <TrustPanel slot="result" lastUpdated={lastUpdated} sourcesId="calculator-sources" />

    <UseCasesPanel title="Wat kun je hiermee?" items={useCases} slot="useCases" />

    <SourceCards id="calculator-sources" title="Bronnen" items={sources} slot="sources" />

    <FaqAccordion title="Veelgestelde vragen" items={faq} slot="faq" />

    <ToolFooter categoryLink="/categorie/belasting/" categoryLabel="Belasting"
      slot="footer"
      disclaimer="Deze uitkomst is een indicatie op basis van je invoer en het 21% btw-tarief van 2026. Controleer belangrijke bedragen via officiële bronnen of een adviseur. Aan de uitkomst kunnen geen rechten worden ontleend."
      lastUpdated={lastUpdated}
    />
  </CalculatorShell>

  <div class="calculator-card calc-content" id="calculator-content">
    <h2 class="page-title">BTW 21 procent berekenen</h2>
    <p>21% btw is het hoge btw-tarief in Nederland. Op deze pagina bereken je direct hoeveel 21% btw is over elk bedrag. Je kunt zowel van exclusief naar inclusief rekenen als van inclusief naar exclusief.</p>
    <p>Wil je het lage tarief gebruiken? Ga dan naar de <a href="/btw-9-procent-berekenen/">BTW 9 procent berekenen</a> pagina. Voor het algemene overzicht met alle tarieven gebruik je de <a href="/btw-calculator/">BTW calculator</a>.</p>

    <h2>De formule voor 21% btw</h2>
    <p>Voor 21% btw gelden deze formules:</p>
    <div class="formula-box">
      <p><strong>Inclusief bedrag = exclusief bedrag &times; 1,21</strong></p>
      <p><strong>Exclusief bedrag = inclusief bedrag &divide; 1,21</strong></p>
      <p><strong>Btw-bedrag = inclusief bedrag &minus; exclusief bedrag</strong></p>
    </div>

    <h2>Voorbeelden 21% btw</h2>
    <table class="rate-table">
      <thead>
        <tr><th>Exclusief</th><th>Btw-bedrag</th><th>Inclusief</th></tr>
      </thead>
      <tbody>
        <tr><td>&euro; 50</td><td>&euro; 10,50</td><td>&euro; 60,50</td></tr>
        <tr><td>&euro; 100</td><td>&euro; 21</td><td>&euro; 121</td></tr>
        <tr><td>&euro; 250</td><td>&euro; 52,50</td><td>&euro; 302,50</td></tr>
        <tr><td>&euro; 500</td><td>&euro; 105</td><td>&euro; 605</td></tr>
        <tr><td>&euro; 1.000</td><td>&euro; 210</td><td>&euro; 1.210</td></tr>
      </tbody>
    </table>

    <h2>Wanneer gebruik je 21% btw?</h2>
    <p>Het hoge tarief van 21% geldt voor de meeste goederen en diensten. Voorbeelden zijn:</p>
    <ul class="calc-list">
      <li>Elektronica en apparatuur</li>
      <li>Kleding en schoenen</li>
      <li>Meubels en huishoudelijke artikelen</li>
      <li>Consultancy en professionele diensten</li>
      <li>Reparatie- en onderhoudswerkzaamheden</li>
      <li>Horeca (eten en drinken in restaurants)</li>
    </ul>
    <p>Voor sommige producten geldt het <a href="/btw-9-procent-berekenen/">lage tarief van 9%</a>. Controleer bij twijfel de <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/btw_berekenen_aan_uw_klanten/btw_berekenen/btw_tarief/btw_tarief" target="_blank" rel="noopener">Belastingdienst</a>.</p>

    <h2>Veelgemaakte fouten</h2>
    <ul class="calc-list">
      <li><strong>21% van het inclusieve bedrag aftrekken:</strong> dit geeft een verkeerd antwoord. Deel door 1,21 om exclusief te krijgen.</li>
      <li><strong>0% btw verwarren met vrijgesteld:</strong> bij 0% vermeld je het op de factuur, bij vrijgesteld niet.</li>
      <li><strong>Afrondingsverschillen negeren:</strong> bij facturen met meerdere regels kunnen kleine verschillen ontstaan.</li>
    </ul>
  </div>

  <div class="calculator-card calc-content">
    <h2>Ook handig binnen btw</h2>
    <ul class="calc-list">
      <li><a href="/btw-calculator/">BTW calculator</a> — alle tarieven en richtingen.</li>
      <li><a href="/btw-9-procent-berekenen/">BTW 9 procent berekenen</a> — het lage tarief.</li>
      <li><a href="/btw-terugrekenen/">BTW terugrekenen</a> — van inclusief naar exclusief.</li>
      <li><a href="/btw-inclusief-exclusief/">BTW inclusief/exclusief</a> — wissel in beide richtingen.</li>
      <li><a href="/exclusief-naar-inclusief-btw/">Exclusief naar inclusief btw</a> — richting excl → incl.</li>
    </ul>
  </div>

  <CrossSellCards
    title="Andere calculators die je helpen"
    items={[
      { href: "/btw-9-procent-berekenen/", title: "BTW 9%", description: "Bereken het lage btw-tarief.", accent: "#3b82f6" },
      { href: "/bruto-netto-2026/", title: "Bruto netto 2026", description: "Bereken een indicatie van je nettoloon.", accent: "#2563eb" },
      { href: "/zzp-calculator/", title: "ZZP Calculator", description: "Reken je uurtarief als ondernemer.", accent: "#7c3aed" },
    ]}
  />
</BaseLayout>

<script>
  import { calculateBtw } from "../lib/calculators/btw";
  import { formatEuro } from "../lib/format/currency";
  import { fillTemplate } from "../lib/format/template";
  import { getRecommendations } from "../lib/recommendations/engine";
  import { updateFinancialJourney } from "../lib/recommendations/client";

  const amountInput = document.getElementById("amount") as HTMLInputElement;
  const hero = document.querySelector("[data-calc-result-hero]") as HTMLElement;
  const heroLabel = document.querySelector(".calc-result-panel-label") as HTMLElement;
  const heroSubtext = document.querySelector(".calc-result-panel-subtext") as HTMLElement;
  const errorBox = document.getElementById("calcError") as HTMLElement;
  const copyLinkBtn = document.getElementById("copyLinkBtn") as HTMLButtonElement;
  const financialJourney = document.querySelector(".calc-financial-journey") as HTMLElement;

  const detailExcl = document.getElementById("detailExcl")!;
  const detailBtw = document.getElementById("detailBtw")!;
  const detailIncl = document.getElementById("detailIncl")!;
  const detailRate = document.getElementById("detailRate")!;

  const rate = 21;
  let direction: "excl" | "incl" = "excl";

  function updateUseCases(amount: number, direction: "excl" | "incl", result: { amountExcl: number; amountIncl: number; btwAmount: number }) {
    const incl = direction === "excl" ? result.amountIncl : amount;

    document.querySelectorAll("[data-usecase]").forEach((card) => {
      const id = card.getAttribute("data-usecase");
      const desc = card.querySelector(".calc-use-cases-card-desc") as HTMLElement;
      if (!desc) return;
      const template = desc.dataset.template;
      const fallback = desc.dataset.fallback || desc.textContent || "";
      if (!template || template === fallback) return;
      desc.textContent = fillTemplate(template, {
        bedrag: formatEuro(amount, 2),
        btw: formatEuro(result.btwAmount, 2),
        excl: formatEuro(result.amountExcl, 2),
        incl: formatEuro(incl, 2),
      }, fallback);

      const anchor = card as HTMLAnchorElement;
      if (id === "terugrekenen") {
        anchor.href = `/btw-terugrekenen/?bedrag=${incl}&tarief=${rate}&richting=incl`;
      } else if (id === "inclusief-exclusief") {
        anchor.href = `/btw-inclusief-exclusief/?bedrag=${amount}&tarief=${rate}&richting=${direction}`;
      } else if (id === "btw-9-procent") {
        anchor.href = `/btw-9-procent-berekenen/?bedrag=${amount}&richting=${direction}`;
      }
    });
  }

  function updateUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = parseFloat(amountInput.value) || 0;

    if (amount > 0) params.set("bedrag", amount.toString());
    else params.delete("bedrag");

    params.set("tarief", rate.toString());
    params.set("richting", direction);

    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState(null, "", newUrl);
  }

  function calculate() {
    const amount = parseFloat(amountInput.value);
    const engineDirection = direction === "excl" ? "exclusive_to_inclusive" : "inclusive_to_exclusive";
    const result = calculateBtw({ amount, rate, direction: engineDirection });

    if (!result.valid) {
      errorBox.style.display = "block";
      hero.textContent = "—";
      detailExcl.textContent = "—";
      detailBtw.textContent = "—";
      detailIncl.textContent = "—";
      detailRate.textContent = "—";
      return;
    }

    errorBox.style.display = "none";

    hero.textContent = formatEuro(direction === "excl" ? result.amountIncl : result.amountExcl, 2);
    heroLabel.textContent = direction === "excl" ? "Bedrag inclusief 21% btw" : "Bedrag exclusief 21% btw";
    heroSubtext.textContent = direction === "excl"
      ? `Dit wordt ${formatEuro(result.amountIncl, 2)} inclusief 21% btw over ${formatEuro(result.amountExcl, 2)} exclusief.`
      : `Dit is ${formatEuro(result.amountExcl, 2)} exclusief btw van ${formatEuro(result.amountIncl, 2)} inclusief.`;

    detailExcl.textContent = formatEuro(result.amountExcl, 2);
    detailBtw.textContent = formatEuro(result.btwAmount, 2);
    detailIncl.textContent = formatEuro(result.amountIncl, 2);
    detailRate.textContent = `${result.rate}% btw`;

    updateUseCases(amount, direction, result);
    if (financialJourney) {
      const recs = getRecommendations({
        calculator: "btw-21-procent",
        values: { amount, rate, direction },
        result,
      });
      updateFinancialJourney(financialJourney, recs);
    }
    updateUrl();
  }

  function applyUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const bedrag = params.get("bedrag");
    const richting = params.get("richting");

    if (bedrag !== null) amountInput.value = bedrag;
    if (richting !== null && (richting === "excl" || richting === "incl")) {
      direction = richting;
      document.querySelectorAll("#btwDirection button").forEach((btn) => {
        const button = btn as HTMLButtonElement;
        const isActive = button.dataset.direction === richting;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }
  }

  function initQuickChips() {
    document.querySelectorAll(".quick-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        const amount = (btn as HTMLElement).dataset.amount;
        if (amount) {
          amountInput.value = amount;
          amountInput.focus();
          calculate();
        }
      });
    });
  }

  function initCopyLink() {
    copyLinkBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const textEl = copyLinkBtn.querySelector(".copy-link-text") as HTMLElement;
        const originalText = textEl.textContent || "Deel deze berekening";
        textEl.textContent = "Link gekopieerd";
        copyLinkBtn.classList.add("copy-link-success");
        setTimeout(() => {
          textEl.textContent = originalText;
          copyLinkBtn.classList.remove("copy-link-success");
        }, 2000);
      } catch (err) {
        console.error("Kon link niet kopiëren", err);
      }
    });
  }

  function initDirectionButtons() {
    document.getElementById("btwDirection")!.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button") as HTMLButtonElement | null;
      if (!btn) return;
      document.querySelectorAll("#btwDirection button").forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-pressed", "true");
      direction = btn.dataset.direction as "excl" | "incl";
      calculate();
    });
  }

  applyUrlParams();
  calculate();
  initQuickChips();
  initCopyLink();
  initDirectionButtons();

  amountInput.addEventListener("input", calculate);
  amountInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      calculate();
      amountInput.blur();
    }
  });
</script>

