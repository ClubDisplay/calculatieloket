---
import ContentHubPage from "../components/calculator/ContentHubPage.astro";
import type { SourceItem, CrossSellItem } from "../components/calculator/ContentHubPage.astro";

const title = "Hypotheek maandlasten berekenen 2026 | Indicatie | Calculatieloket.nl";
const description = "Bereken je hypotheek maandlasten in 2026. Een indicatie van aflossing en rente. Voor advies raadpleeg je een hypotheekadviseur.";
const h1 = "Hypotheek maandlasten berekenen 2026";

const intro = [
  "Wil je weten wat je maandlasten worden bij een hypotheek? De maandlasten bestaan uit rente en aflossing. Hoe hoog ze uitvallen, hangt af van het leenbedrag, de rente en de looptijd.",
  "Deze pagina geeft een algemene indicatie. Gebruik de hypotheek calculator voor een berekening op basis van je eigen situatie.",
];

const sources: SourceItem[] = [
  {
    label: "Officiële bron",
    title: "AFM — Hypotheekregels",
    description: "Informatie over verantwoord lenen.",
    href: "https://www.afm.nl/consumenten/hypotheek",
  },
  {
    label: "Officiële bron",
    title: "NHG — Nationale Hypotheek Garantie",
    description: "Informatie over NHG.",
    href: "https://www.nhg.nl",
  },
];

const crossSell: CrossSellItem[] = [
  { title: "Hypotheek calculator", description: "Bereken een hypotheekindicatie.", href: "/hypotheek-calculator/", accent: "#d97706" },
  { title: "Maximale hypotheek", description: "Bereken hoeveel je kunt lenen.", href: "/maximale-hypotheek-berekenen/", accent: "#f59e0b" },
  { title: "Hypotheek rente", description: "Bereken de rente op je hypotheek.", href: "/hypotheek-rente-berekenen/", accent: "#b45309" },
];

const relatedLinks = [
  { href: "/hypotheek-calculator/", label: "Hypotheek calculator — volledige hypotheekindicatie" },
  { href: "/maximale-hypotheek-berekenen/", label: "Maximale hypotheek berekenen" },
  { href: "/hypotheek-rente-berekenen/", label: "Hypotheek rente berekenen" },
  { href: "/hypotheek-2026/", label: "Hypotheek 2026" },
];

const faq = [
  {
    question: "Hoe bereken je hypotheek maandlasten?",
    answer: "Je maandlasten bestaan uit rente en aflossing. Bij een annuïteitenhypotheek betaal je iedere maand hetzelfde bedrag, waarbij in het begin vooral rente en later meer aflossing zit. De formule is: maandlast = (rente + aflossing) / 12, afhankelijk van rente en looptijd.",
  },
  {
    question: "Wat kost een hypotheek van € 300.000 per maand?",
    answer: "Dat hangt af van de rente en looptijd. Bij een rente van 4% en 30 jaar annuïteiten betaal je circa € 1.430 per maand. Bij een lagere rente dalen de maandlasten. Dit is een indicatie.",
  },
  {
    question: "Wat is het verschil tussen annuïteiten en lineair?",
    answer: "Bij een annuïteitenhypotheek betaal je iedere maand hetzelfde bedrag. Bij een lineaire hypotheek betaal je elke maand hetzelfde aflossingsbedrag, maar de rente daalt naarmate je meer hebt afgelost. De maandlasten dalen dus bij een lineaire hypotheek.",
  },
  {
    question: "Hoeveel rente betaal ik aan de start?",
    answer: "Bij een annuïteitenhypotheek betaal je in het begin relatief veel rente en weinig aflossing. Naarmate de looptijd vordert, draait dit om.",
  },
  {
    question: "Wat gebeurt er als de rente stijgt?",
    answer: "Als je een variabele rente hebt, stijgen je maandlasten. Bij een vaste rente blijven ze gelijk binnen de rentevaste periode. Let op: bij afloop van de rentevaste periode kan de rente veranderen.",
  },
  {
    question: "Moet ik ook aflossen?",
    answer: "Voor een hypotheek met volledige renteaftrek moet je annuïtair of lineair aflossen op de gehele hypotheek. Voor andere hypotheekvormen gelden andere regels. Raadpleeg een adviseur.",
  },
];

const howTo = {
  name: "Hypotheek maandlasten berekenen",
  description: "Stappen om je hypotheek maandlasten te berekenen.",
  steps: [
    { name: "Vul je hypotheekbedrag in", text: "Voer het totale leenbedrag in." },
    { name: "Kies een rente", text: "Gebruik een actuele rente als indicatie." },
    { name: "Kies een looptijd", text: "Meestal 20 of 30 jaar." },
    { name: "Bekijk de maandlast", text: "De calculator toont een indicatie van je maandlast." },
  ],
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Wonen", href: "/categorie/wonen/" },
  { label: "Hypotheek maandlasten berekenen", current: true },
];
---

<ContentHubPage
  title={title}
  description={description}
  h1={h1}
  breadcrumbs={breadcrumbs}
  intro={intro}
  sources={sources}
  faq={faq}
  relatedLinks={relatedLinks}
  crossSell={crossSell}
  howTo={howTo}
  categoryLabel="Wonen"
  calculatorCta={{ href: "/hypotheek-calculator/", title: "Hypotheek calculator openen", description: "Vul je hypotheekbedrag, rente en looptijd in voor een indicatie van je maandlasten." }}
>
  <Fragment slot="content">
    <h2>Hypotheek maandlasten</h2>
    <p>Je maandlasten bestaan uit rente en aflossing. Bij een annuïteitenhypotheek betaal je elke maand hetzelfde bedrag. Bij een lineaire hypotheek betaal je elke maand evenveel aflossing, maar de rente en dus de totale maandlast neemt af.</p>

    <h2>Voorbeeld maandlasten</h2>
    <p>Indicatie bij 30 jaar annuïteiten:</p>
    <table class="rate-table">
      <thead><tr><th>Hypotheek</th><th>Rente 3,5%</th><th>Rente 4,5%</th></tr></thead>
      <tbody>
        <tr><td>€ 200.000</td><td>Circa € 900</td><td>Circa € 1.010</td></tr>
        <tr><td>€ 300.000</td><td>Circa € 1.350</td><td>Circa € 1.520</td></tr>
        <tr><td>€ 400.000</td><td>Circa € 1.800</td><td>Circa € 2.030</td></tr>
      </tbody>
    </table>
    <p>Dit zijn indicaties. De werkelijke maandlasten hangen af van de rente, looptijd, hypotheekvorm en bankvoorwaarden.</p>

    <h2>Factoren die de maandlast beïnvloeden</h2>
    <ul class="calc-list">
      <li><strong>Hypotheekbedrag:</strong> hoe meer je leent, hoe hoger de maandlast.</li>
      <li><strong>Rente:</strong> een hogere rente geeft hogere maandlasten.</li>
      <li><strong>Looptijd:</strong> een langere looptijd geeft lagere maandlasten, maar meer rente in totaal.</li>
      <li><strong>Aflossingsvorm:</strong> annuïteit of lineair.</li>
      <li><strong>Extra aflossen:</strong> dit verlaagt de maandlast of looptijd.</li>
    </ul>

    <h2>Advies</h2>
    <p>Deze pagina geeft alleen een indicatie. Voor een persoonlijke berekening en advies over de beste hypotheekvorm neem je contact op met een erkend hypotheekadviseur.</p>
  </Fragment>
</ContentHubPage>
