---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import {
  getSearchIndex,
  getSearchIcons,
  getFeaturedCards,
  getHomeCategories,
  getQuickLinks,
} from "../lib/calculators/registry";

const title = "Calculatieloket.nl | Gratis berekeningen voor salaris, BTW, hypotheek en meer";
const description = "Snel antwoord op jouw financiële vraag. Gratis berekeningen voor salaris, BTW, hypotheek, toeslagen, ZZP en auto-kosten. Geen account, gebaseerd op officiële bronnen.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Calculatieloket.nl",
  "url": "https://calculatieloket.nl/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://calculatieloket.nl/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "name": "Calculatieloket.nl",
  "url": "https://calculatieloket.nl",
  "logo": "https://calculatieloket.nl/logo_Calculatieloket-og.png",
  "email": "contact@calculatieloket.nl",
  "areaServed": "NL",
  "priceRange": "€",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "email": "contact@calculatieloket.nl",
    "availableLanguage": "Dutch",
  },
};

const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Zijn de berekeningen gratis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, alle berekeningen op Calculatieloket.nl zijn volledig gratis te gebruiken. Je hebt geen account nodig.",
      },
    },
    {
      "@type": "Question",
      "name": "Worden mijn gegevens opgeslagen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nee. Alles gebeurt in je eigen browser. Wat je invult wordt niet door ons opgeslagen. Lees meer in ons privacybeleid.",
      },
    },
    {
      "@type": "Question",
      "name": "Waarom is de uitkomst een indicatie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We gebruiken officiële tarieven, maar je persoonlijke situatie kan afwijken. Gebruik de uitkomst als richtlijn.",
      },
    },
  ],
};

const homeSchemas = [organizationSchema, homeFaqSchema];

const searchIndex = getSearchIndex();
const searchIcons = getSearchIcons();
const cards = getFeaturedCards();
const homeCategories = getHomeCategories();
const quickLinks = getQuickLinks();
---

<BaseLayout title={title} description={description} containerClass="container-wide">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(homeSchemas)} />

  <!-- ===== HERO v3 ===== -->
  <section class="home-hero" slot="hero">
    <div class="home-hero-inner">
      <h1 class="hero-home-title">Krijg inzicht in je financiële vraag</h1>
      <p class="hero-home-sub">Zoek een berekening of kies een onderwerp. Binnen een paar klikken zie je een indicatie.</p>

      <div class="hp-search-wrap">
        <label for="hpSearch" class="visually-hidden">Zoek een berekening of onderwerp</label>
        <input type="search" id="hpSearch" class="hp-search" role="combobox" aria-haspopup="listbox" placeholder="Bijvoorbeeld: salaris, BTW, hypotheek..." autocomplete="off" inputmode="search" enterkeyhint="search" data-analytics="search-input" data-analytics-category="homepage" data-analytics-action="input" data-analytics-label="search" aria-controls="hpSearchListbox" aria-autocomplete="list" aria-expanded="false" />
        <span class="hp-search-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </span>
        <button type="button" class="hp-search-clear" id="hpSearchClear" aria-label="Zoekopdracht wissen" tabindex="0" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <div id="hpSearchResults" class="hp-search-results" aria-label="Zoekresultaten" hidden>
          <div id="hpSearchListbox" class="hp-search-listbox" role="listbox" aria-label="Zoekresultaten"></div>
          <div class="hp-search-footer">
            <a href="/calculators/" class="hp-search-footer-link">
              Bekijk alle berekeningen <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
      <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)}></script>
      <script is:inline>
        window.__SEARCH_INDEX__ = JSON.parse(document.getElementById('search-data').textContent);
      </script>
      <script type="application/json" id="search-icons" set:html={JSON.stringify(searchIcons)}></script>
      <script is:inline>
        window.__SEARCH_ICONS__ = JSON.parse(document.getElementById('search-icons').textContent);
      </script>

      <div class="hero-trust">
        <span class="hero-trust-item">
          <svg class="hti-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#059669" stroke-width="2"/><path d="M5 8l2 2 4-4" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Gratis</span>
        </span>
        <span class="hero-trust-item">
          <svg class="hti-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#059669" stroke-width="2"/><path d="M5 8l2 2 4-4" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Geen account</span>
        </span>
        <span class="hero-trust-item">
          <svg class="hti-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#059669" stroke-width="2"/><path d="M5 8l2 2 4-4" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Geen opslag</span>
        </span>
        <span class="hero-trust-item">
          <svg class="hti-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#059669" stroke-width="2"/><path d="M5 8l2 2 4-4" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Officiële bronnen</span>
        </span>
      </div>

      <div class="hp-quick-chips" aria-label="Populaire berekeningen">
        {quickLinks.map((link) => (
          <a href={link.href} class="hp-cluster-chip" data-analytics="quick-start-chip" data-analytics-category="homepage" data-analytics-action="click" data-analytics-label={link.label}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MEESTGEZOCHT ===== -->
  <section id="populair" class="hp-section">
    <h2 class="section-heading">Meestgezocht</h2>

    <div class="hp-grid" id="popularGrid">
      {cards.map((card) => (
        <a
          href={card.href}
          class="hp-card"
          data-title={card.title.toLowerCase()}
          data-keywords={card.keywords.toLowerCase()}
          style={`--hp-accent: ${card.accent}`}
          data-analytics="popular-card"
          data-analytics-category="homepage"
          data-analytics-action="click"
          data-analytics-label={card.id}
        >
          <span class="hp-card-icon" set:html={card.icon} />
          <div class="hp-card-body">
            <h3 class="hp-card-title">{card.title}</h3>
            <p class="hp-card-question">{card.question}</p>
          </div>
          <span class="hp-card-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
    <p class="hp-section-footer"><a href="/calculators/" data-analytics="view-all-link" data-analytics-category="homepage" data-analytics-action="click" data-analytics-label="all-calculators">Alle berekeningen</a></p>
  </section>

  <!-- ===== CATEGORIEËN ===== -->
  <section id="onderwerpen" class="hp-section">
    <h2 class="section-heading">Waar gaat je vraag over?</h2>
    <div class="home-category-grid">
      {homeCategories.map((cat) => (
        <a href={cat.href} class="home-category-card" data-analytics="category-card" data-analytics-category="homepage" data-analytics-action="click" data-analytics-label={cat.id}>
          <span class="home-category-icon" set:html={cat.icon} />
          <span class="home-category-label">{cat.label}</span>
        </a>
      ))}
    </div>
  </section>

  <AdSlot slot="1234567893" format="auto" style="min-height:120px" />

  <!-- ===== FAQ ===== -->
  <section class="faq-section">
    <h2 class="section-heading">Veelgestelde vragen</h2>

    <details class="faq-item">
      <summary>Zijn de berekeningen gratis?</summary>
      <p>Ja, alle berekeningen op Calculatieloket.nl zijn volledig gratis te gebruiken. Je hebt geen account nodig.</p>
    </details>

    <details class="faq-item">
      <summary>Worden mijn gegevens opgeslagen?</summary>
      <p>Nee. Alles gebeurt in je eigen browser. Wat je invult wordt niet door ons opgeslagen. Lees meer in ons <a href="/privacy/">privacybeleid</a>.</p>
    </details>

    <details class="faq-item">
      <summary>Waarom is de uitkomst een indicatie?</summary>
      <p>We gebruiken officiële tarieven, maar je persoonlijke situatie kan afwijken. Gebruik de uitkomst als richtlijn.</p>
    </details>
  </section>
</BaseLayout>

<script>
  (function () {
    const searchInput = document.getElementById("hpSearch") as HTMLInputElement;
    const resultsEl = document.getElementById("hpSearchResults") as HTMLElement;
    const listboxEl = document.getElementById("hpSearchListbox") as HTMLElement;
    const footerEl = resultsEl.querySelector(".hp-search-footer") as HTMLElement;
    const clearBtn = document.getElementById("hpSearchClear") as HTMLButtonElement;
    const searchData = (window as any).__SEARCH_INDEX__ || [];
    const searchIcons = (window as any).__SEARCH_ICONS__ || {};
    let results: any[] = [];
    let selectedIndex = -1;
    let lastQuery = "";

    function escapeHtml(text: string) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function getIcon(key: string) {
      return searchIcons[key] || searchIcons.calc || "";
    }

    function highlight(text: string, query: string) {
      const escaped = escapeHtml(text);
      const words = query
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter((w) => w.length >= 2);
      if (!words.length) return escaped;
      const pattern = new RegExp(
        "(" + words.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|") + ")",
        "gi"
      );
      return escaped.replace(pattern, "<mark>$1</mark>");
    }

    function search(query: string) {
      const normalized = query.toLowerCase().trim();
      if (!normalized) return [];
      const words = normalized.split(/\s+/).filter(Boolean);

      return searchData
        .map((item: any) => {
          let score = 0;
          const title = item.title.toLowerCase();
          const titleWords = title.split(/\s+/);
          const description = item.description.toLowerCase();
          const category = item.category.toLowerCase();
          const url = item.url.toLowerCase();
          const keywords = item.keywords.map((k: string) => k.toLowerCase());
          const allText = [title, description, category, url, ...keywords].join(" ");

          // Intent matching — highest priority
          (item.intents || []).forEach((intent: string) => {
            const intentNorm = intent.toLowerCase();
            if (intentNorm === normalized) score += 200;
            else if (intentNorm.includes(normalized)) score += 160;
            else if (normalized.includes(intentNorm)) score += 140;
            else {
              const intentWords = intentNorm.split(/\s+/);
              words.forEach((word: string) => {
                if (intentWords.some((iw: string) => iw === word)) score += 80;
                else if (intentWords.some((iw: string) => iw.startsWith(word))) score += 50;
                else if (intentWords.some((iw: string) => iw.includes(word))) score += 30;
              });
            }
          });

          if (allText.includes(normalized)) score += 10;

          words.forEach((word: string) => {
            if (titleWords.some((t: string) => t === word)) score += 120;
            else if (titleWords.some((t: string) => t.startsWith(word))) score += 100;
            else if (title.includes(word)) score += 70;

            if (keywords.some((k: string) => k === word)) score += 90;
            else if (keywords.some((k: string) => k.startsWith(word))) score += 60;
            else if (keywords.some((k: string) => k.includes(word))) score += 50;

            if (description.includes(word)) score += 30;
            if (category.includes(word)) score += 20;
            if (url.includes(word)) score += 20;
          });

          return { item, score };
        })
        .filter((r: any) => r.score > 0)
        .sort((a: any, b: any) => b.score - a.score)
        .slice(0, 6)
        .map((r: any) => r.item);
    }

    function render() {
      const query = searchInput.value;
      lastQuery = query;
      clearBtn.hidden = !query.trim();

      if (!query.trim()) {
        close();
        return;
      }

      if (!results.length) {
        listboxEl.innerHTML = `
          <div class="hp-search-empty">
            <span class="hp-search-empty-icon" aria-hidden="true">🔍</span>
            <p class="hp-search-empty-text">Geen passende berekening gevonden.</p>
            <a href="/calculators/" class="hp-search-empty-link">
              Bekijk alle berekeningen <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        `;
        footerEl.hidden = true;
        showResults();
        return;
      }

      footerEl.hidden = false;
      listboxEl.innerHTML = results
        .map((item: any, i: number) => {
          const selected = i === selectedIndex;
          const iconSvg = getIcon(item.icon || item.category.toLowerCase());
          return `
            <a href="${item.url}" id="hp-search-opt-${i}" class="hp-search-result ${selected ? "selected" : ""}" role="option" data-index="${i}" aria-selected="${selected}">
              <span class="hp-search-result-icon" aria-hidden="true">${iconSvg}</span>
              <span class="hp-search-result-body">
                <span class="hp-search-result-title">${highlight(item.title, query)}</span>
                <span class="hp-search-result-meta">${highlight(item.description, query)}</span>
              </span>
              <span class="hp-search-result-actions">
                <span class="hp-search-result-category">${escapeHtml(item.category)}</span>
                <span class="hp-search-result-arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          `;
        })
        .join("");
      updateSelection();
      showResults();
    }

    function showResults() {
      if (resultsEl.hidden) {
        resultsEl.classList.remove("hp-search-results--open");
        void resultsEl.offsetWidth;
        resultsEl.hidden = false;
        resultsEl.classList.add("hp-search-results--open");
      }
      searchInput.setAttribute("aria-expanded", "true");
    }

    function updateSelection() {
      const items = listboxEl.querySelectorAll(".hp-search-result");
      items.forEach((el, i) => {
        el.classList.toggle("selected", i === selectedIndex);
        el.setAttribute("aria-selected", String(i === selectedIndex));
      });
      if (selectedIndex >= 0 && items[selectedIndex]) {
        items[selectedIndex].scrollIntoView({ block: "nearest" });
        searchInput.setAttribute("aria-activedescendant", items[selectedIndex].id);
      } else {
        searchInput.removeAttribute("aria-activedescendant");
      }
    }

    function close() {
      resultsEl.classList.remove("hp-search-results--open");
      resultsEl.hidden = true;
      selectedIndex = -1;
      searchInput.setAttribute("aria-expanded", "false");
      searchInput.removeAttribute("aria-activedescendant");
      clearBtn.hidden = !searchInput.value.trim();
    }

    function runSearch() {
      const query = searchInput.value;
      results = search(query);
      selectedIndex = results.length ? 0 : -1;
      render();
    }

    function openSelection() {
      if (selectedIndex >= 0 && results[selectedIndex]) {
        window.location.href = results[selectedIndex].url;
        return;
      }
      results = search(searchInput.value);
      if (results.length) {
        selectedIndex = 0;
        window.location.href = results[0].url;
      } else {
        render();
      }
    }

    searchInput.addEventListener("input", runSearch);

    searchInput.addEventListener("focus", () => {
      if (searchInput.value.trim()) runSearch();
    });

    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        openSelection();
        return;
      }

      if (resultsEl.hidden && (e.key === "ArrowDown" || e.key === "ArrowUp")) {
        runSearch();
        if (!resultsEl.hidden) e.preventDefault();
        return;
      }

      if (resultsEl.hidden) return;

      if (e.key === "ArrowDown") {
        selectedIndex = (selectedIndex + 1) % results.length;
        updateSelection();
        e.preventDefault();
      } else if (e.key === "ArrowUp") {
        selectedIndex = (selectedIndex - 1 + results.length) % results.length;
        updateSelection();
        e.preventDefault();
      } else if (e.key === "Home") {
        selectedIndex = 0;
        updateSelection();
        e.preventDefault();
      } else if (e.key === "End") {
        selectedIndex = results.length - 1;
        updateSelection();
        e.preventDefault();
      } else if (e.key === "Escape") {
        close();
        searchInput.blur();
      }
    });

    clearBtn.addEventListener("click", () => {
      searchInput.value = "";
      runSearch();
      searchInput.focus();
    });

    resultsEl.addEventListener("click", (e) => {
      const result = (e.target as HTMLElement).closest(".hp-search-result") as HTMLElement | null;
      if (result) {
        const href = result.getAttribute("href");
        if (href) window.location.href = href;
      }
    });

    document.addEventListener("click", (e) => {
      if (!searchInput.contains(e.target as Node) && !resultsEl.contains(e.target as Node) && !clearBtn.contains(e.target as Node)) {
        close();
      }
    });
  })();
</script>

<style is:global>
  /* ===== HERO v3 ===== */
  .home-hero {
    width: 100%;
    background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%);
    padding: 3rem 0 2rem;
    margin-bottom: 2rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .home-hero-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero-home-title {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .hero-home-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 480px;
  }

  .hp-search-wrap {
    position: relative;
    width: 100%;
    max-width: 600px;
    z-index: 50;
  }

  .hp-search {
    width: 100%;
    padding: 1rem 2.75rem 1rem 3rem;
    font-size: 1.1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .hp-search::-webkit-search-cancel-button,
  .hp-search::-webkit-search-decoration {
    display: none;
  }

  .hp-search:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-primary-light), 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .hp-search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    opacity: 0.6;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp-search-icon svg {
    display: block;
  }

  .hp-search-clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
  }

  .hp-search-clear[hidden] {
    display: none;
  }

  .hp-search-clear svg {
    display: block;
  }

  .hp-search-clear:hover,
  .hp-search-clear:focus-visible {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.9rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .hero-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .hti-icon {
    display: block;
    flex-shrink: 0;
  }

  .hp-quick-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .hp-cluster-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    text-decoration: none;
  }

  .hp-cluster-chip:hover,
  .hp-cluster-chip:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== SECTIONS ===== */
  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .hp-section {
    margin-bottom: 1.75rem;
  }

  .hp-section-footer {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .hp-section-footer a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .hp-section-footer a:hover,
  .hp-section-footer a:focus-visible {
    text-decoration: underline;
  }

  .hp-no-results {
