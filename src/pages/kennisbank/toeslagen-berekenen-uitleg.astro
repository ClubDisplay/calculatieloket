---
import ContentHubPage from "../../components/calculator/ContentHubPage.astro";
import type { SourceItem, CrossSellItem } from "../../components/calculator/ContentHubPage.astro";
import { calculateAllowances } from "../../lib/calculators/allowances";
import { formatEuro } from "../../lib/format/currency";

const title = "Toeslagenkaart 2026: bedragen, grenzen en berekenen | Calculatieloket.nl";
const description = "Bekijk de belangrijkste bedragen uit de Toeslagenkaart 2026. Uitleg over huurtoeslag, zorgtoeslag, kindgebonden budget, inkomen en vermogen.";
const h1 = "Toeslagenkaart 2026: bedragen en grenzen";

const example = calculateAllowances({
  income: 28000,
  partnerIncome: 0,
  isCouple: false,
  rent: 700,
});

const intro = [
  "Zoek je de bedragen en grenzen van de <strong>Toeslagenkaart 2026</strong>? Hieronder staan de belangrijkste bedragen voor huurtoeslag, zorgtoeslag en kindgebonden budget overzichtelijk bij elkaar, met uitleg over de betekenis ervan.",
  "De tabellen helpen je de regels te lezen, maar zeggen op zichzelf nog niets over jouw persoonlijke toeslag. Gebruik onze <a href=\"/toeslagen-calculator/\">toeslagen calculator</a> voor een indicatie van huur- en zorgtoeslag en controleer je situatie daarna met de officiële proefberekening op Toeslagen.nl.",
];

const sources: SourceItem[] = [
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — Toeslagenkaart 2026",
    description: "De officiële publicatie met grensbedragen en percentages voor 2026.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/themaoverstijgend/brochures_en_publicaties/toeslagenkaart",
  },
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — Berekening huurtoeslag 2026",
    description: "De zeven rekenstappen, basishuur, grenzen en inkomensafhankelijke correctie.",
    href: "https://download.belastingdienst.nl/toeslagen/docs/berekening_huurtoeslag_tg0831z62fd.pdf",
  },
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — Inkomensgrens zorgtoeslag",
    description: "De inkomensgrenzen voor alleenstaanden en toeslagpartners in 2026.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/nl/zorgtoeslag/content/maximaal-inkomen-voor-zorgtoeslag",
  },
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — Kindgebonden budget",
    description: "Voorwaarden en aanvraagprocedure voor kindgebonden budget.",
    href: "https://www.toeslagen.nl/kindgebonden-budget",
  },
];

const crossSell: CrossSellItem[] = [
  { title: "Toeslagen calculator", description: "Bereken een indicatie van huur- en zorgtoeslag.", href: "/toeslagen-calculator/", accent: "#2563eb" },
  { title: "Kindgebonden budget", description: "Lees de uitleg voor gezinnen met kinderen.", href: "/kennisbank/kindgebonden-budget-uitleg/", accent: "#7c3aed" },
  { title: "Bruto netto 2026", description: "Bereken een indicatie van je nettoloon.", href: "/bruto-netto-2026/", accent: "#d97706" },
];

const relatedLinks = [
  { href: "/toeslagen-calculator/", label: "Toeslagen calculator — huur- en zorgtoeslag indicatie" },
  { href: "/kennisbank/kindgebonden-budget-uitleg/", label: "Kindgebonden budget — voorwaarden en kinderbijslag" },
  { href: "/kennisbank/sparen-vermogen-uitleg/", label: "Sparen en vermogen — invloed op toeslagen" },
  { href: "/bruto-netto-2026/", label: "Bruto-netto salaris — bereken een netto-indicatie" },
];

const faq = [
  {
    question: "Wat staat er op de Toeslagenkaart 2026?",
    answer: "De Toeslagenkaart bevat de belangrijkste bedragen en percentages voor huurtoeslag, kinderopvangtoeslag, kindgebonden budget en zorgtoeslag in 2026. Denk aan inkomensgrenzen, maximale bedragen, vermogensgrenzen en rekenregels.",
  },
  {
    question: "Wat is een toetsingsinkomen?",
    answer: "Het toetsingsinkomen is het inkomen dat Dienst Toeslagen gebruikt voor je toeslag. Het is niet hetzelfde als je nettoloon. Gebruik bij een proefberekening het toetsingsinkomen van jou en eventueel je toeslagpartner; je kunt dit onder andere afleiden uit je belastingaangifte of jaaropgave.",
  },
  {
    question: "Is de rekengrens voor huurtoeslag een maximale huur?",
    answer: "Nee. In 2026 sluit een kale huur boven de rekengrens je niet automatisch uit. De rekenhuur wordt voor de berekening wel afgetopt. Daarnaast gelden onder andere voorwaarden voor je woning, huishouden, inkomen en vermogen.",
  },
  {
    question: "Telt vermogen mee voor toeslagen?",
    answer: "Ja. Voor huurtoeslag gelden andere vermogensgrenzen dan voor zorgtoeslag en kindgebonden budget. Onze eenvoudige calculator toetst je vermogen niet; de officiële proefberekening doet dat wel.",
  },
  {
    question: "Is een tabelbedrag het bedrag dat ik ontvang?",
    answer: "Niet noodzakelijk. Een maximumbedrag geldt alleen in bepaalde situaties en kan door inkomen, huishouden en andere omstandigheden lager uitvallen. Alleen Dienst Toeslagen stelt je toeslag vast.",
  },
