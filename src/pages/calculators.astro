---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CategoryHero from "../components/category/CategoryHero.astro";
import CategoryGrid from "../components/category/CategoryGrid.astro";
import RelatedCategories from "../components/category/RelatedCategories.astro";
import AdSlot from "../components/AdSlot.astro";
import {
  getCategoryList,
  getCalculatorGroupsForHub,
} from "../lib/calculators/registry";
import { parseDutchDate } from "../lib/format/date";

const title = "Alle calculators | Calculatieloket.nl";
const description = "Ontdek alle 10 gratis calculators van Calculatieloket.nl. Van inkomen, belasting en wonen tot ondernemen en auto. Snel, duidelijk en gebaseerd op officiële bronnen.";

const categoryList = getCategoryList();
const calculatorGroups = getCalculatorGroupsForHub();
const allCalculators = calculatorGroups.flatMap((group) => group.items);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://calculatieloket.nl/" },
    { "@type": "ListItem", position: 2, name: "Alle calculators", item: "https://calculatieloket.nl/calculators/" },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Alle calculators",
  url: "https://calculatieloket.nl/calculators/",
  description,
  inLanguage: "nl-NL",
  isPartOf: {
    "@type": "WebSite",
    name: "Calculatieloket.nl",
    url: "https://calculatieloket.nl/",
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allCalculators.map((calc, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: calc.title,
      url: `https://calculatieloket.nl${calc.href}`,
    })),
  },
};

const lastUpdated = "4 augustus 2026";
const lastUpdatedIso = parseDutchDate(lastUpdated);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Alle calculators van Calculatieloket.nl",
  description,
  author: { "@type": "Organization", name: "Calculatieloket.nl" },
  publisher: {
    "@type": "Organization",
    name: "Calculatieloket.nl",
    logo: {
      "@type": "ImageObject",
      url: "https://calculatieloket.nl/logo_Calculatieloket-og.png",
    },
  },
  datePublished: lastUpdatedIso,
  dateModified: lastUpdatedIso,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": "https://calculatieloket.nl/calculators/",
  },
  inLanguage: "nl-NL",
};

const pillarFaq = [
  {
    question: "Zijn alle calculators echt gratis?",
    answer: "Ja, alle calculators zijn gratis te gebruiken. Je hoeft geen account aan te maken en er is geen betaalmuur.",
  },
  {
    question: "Welke categorieën zijn er?",
    answer: "We hebben calculators voor inkomen, wonen, belasting, ondernemen en auto. Zoek je iets specifieks? Gebruik de zoekbalk bovenaan de pagina.",
  },
  {
    question: "Kan ik de uitkomst gebruiken voor mijn belastingaangifte?",
    answer: "De uitkomsten zijn een indicatie. Gebruik ze als richtlijn en controleer belangrijke bedragen altijd via officiële bronnen of een adviseur.",
  },
];

const pillarFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pillarFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const schemaJson = JSON.stringify([breadcrumbSchema, collectionSchema, articleSchema, pillarFaqSchema]);
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" slot="head" set:html={schemaJson} />

  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Alle calculators", current: true },
    ]}
    analyticsCategory="calculator-hub"
  />

  <CategoryHero
    title="Alle calculators"
    subtitle="Vind de juiste rekentool voor jouw situatie"
    intro="Bekijk alle calculators van Calculatieloket.nl, geordend per categorie. Van bruto-netto en toeslagen tot hypotheek, btw, zzp en auto importeren. Iedere tool is gratis, vraagt geen account en is gebaseerd op officiële bronnen."
  />

  <section class="hub-search" aria-label="Zoek calculators">
    <label for="calcSearch" class="visually-hidden">Zoek een calculator</label>
    <div class="hub-search-wrap">
      <span class="hub-search-icon" aria-hidden="true">🔍</span>
      <input
        type="text"
        id="calcSearch"
        class="hub-search-input"
        placeholder="Zoek bijvoorbeeld: salaris, btw, hypotheek..."
        autocomplete="off"
        data-analytics="calculator-hub-search"
        data-analytics-category="calculator-hub"
        data-analytics-action="input"
        data-analytics-label="search"
      />
    </div>
    <p class="hub-search-hint" aria-live="polite" id="calcSearchHint">Typ een zoekwoord om calculators te filteren.</p>
  </section>

  <div class="hub-groups">
    {calculatorGroups.map((group) => (
      <CategoryGrid
        title={group.category}
        items={group.items}
        analyticsCategory="calculator-hub"
      />
    ))}
  </div>

  <p class="hub-no-results" id="calcNoResults" style="display: none;">
    Geen calculators gevonden voor dit zoekwoord. <a href="/calculators/">Toon alle calculators</a>.
  </p>

  <AdSlot slot="1234567892" format="auto" style="min-height:120px" />

  <RelatedCategories
    categories={categoryList}
    title="Bekijk calculators per categorie"
    analyticsCategory="calculator-hub"
  />

  <section class="calculator-card pillar-content" aria-labelledby="pillar-title">
    <h2 id="pillar-title">Gratis online berekeningen voor iedere situatie</h2>
    <p>
      Calculatieloket.nl bundelt de meestgezochte financiële berekeningen in één overzichtelijke website. Je hoeft geen spreadsheet te bouwen of ingewikkelde tabellen te doorzoeken: vul je gegevens in en zie direct een indicatie.
    </p>

    <h3>Altijd gratis, zonder account</h3>
    <p>
      Alle calculators zijn gratis. Je hoeft geen account aan te maken, geen app te installeren en geen betaalmuur te passeren. We tonen mogelijk advertenties, maar alleen als je daarvoor toestemming geeft via de cookiebanner. Weiger je advertenties? De site blijft volledig functioneel.
    </p>

    <h3>Keuze uit vijf categorieën</h3>
    <ul>
      <li><strong>Inkomen</strong> — denk aan bruto-netto salaris, vakantiegeld, toeslagen en loonheffing.</li>
      <li><strong>Wonen</strong> — van maximale hypotheek tot maandlasten en rente.</li>
      <li><strong>Belasting</strong> — onder andere BTW berekenen, inclusief/exclusief en terugrekenen.</li>
      <li><strong>Ondernemen</strong> — voor ZZP'ers: uurtarief, omzet, inkomen en kosten.</li>
      <li><strong>Auto</strong> — momenteel onder andere importkosten berekenen.</li>
    </ul>

    <h3>Wetgeving, privacy en veiligheid</h3>
    <p>
      Onze berekeningen zijn gebaseerd op officiële bronnen zoals de Belastingdienst, Rijksoverheid, Dienst Toeslagen, AFM, NHG, KVK en RDW. We controleren de parameters jaarlijks en passen deze aan zodra nieuwe cijfers bekend zijn. Wat je invult in een calculator blijft in je eigen browser: we slaan geen persoonlijke gegevens op.
    </p>

    <h3>Rekenvoorbeeld: van bruto naar netto</h3>
    <p>
      Stel je hebt een bruto maandsalaris van € 3.500, betaalt € 150 pensioenpremie per maand en de loonheffingskorting is van toepassing. Onze <a href="/bruto-netto-2026/">bruto-netto calculator</a> geeft dan een netto-indicatie van circa € 2.800 per maand. Je werkelijke loonstrook kan afwijken door cao, bonussen, reiskosten of andere persoonlijke situaties.
    </p>

    <h2>Veelgestelde vragen</h2>
    {pillarFaq.map((item) => (
      <details class="pillar-faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </section>

  <p class="pillar-footer">Laatst bijgewerkt: {lastUpdated}. De informatie op deze pagina is een indicatie. Raadpleeg voor belangrijke beslissingen altijd een adviseur of officiële bron.</p>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const input = document.getElementById("calcSearch") as HTMLInputElement | null;
      const hint = document.getElementById("calcSearchHint");
      const noResults = document.getElementById("calcNoResults");
      const sections = document.querySelectorAll(".cat-grid-section");

      if (!input || sections.length === 0) return;

      const updateFilter = () => {
        const query = input.value.toLowerCase().trim();
        let totalVisible = 0;

        sections.forEach((section) => {
          const sectionTitle = section.querySelector(".cat-grid-section-title")?.textContent?.toLowerCase() || "";
          const cards = section.querySelectorAll(".cat-card");
          const sectionMatches = query.length === 0 || sectionTitle.includes(query);
          let visibleCount = 0;

          cards.forEach((card) => {
            const text = card.textContent?.toLowerCase() || "";
            const match = query.length === 0 || sectionMatches || text.includes(query);
            (card as HTMLElement).style.display = match ? "" : "none";
            if (match) visibleCount++;
          });

          (section as HTMLElement).style.display = visibleCount > 0 ? "" : "none";
          totalVisible += visibleCount;
        });

        if (hint) {
          if (query.length === 0) {
            hint.textContent = "Typ een zoekwoord om calculators te filteren.";
          } else if (totalVisible === 0) {
            hint.textContent = "Geen resultaten gevonden.";
          } else {
            hint.textContent = `${totalVisible} calculator${totalVisible === 1 ? "" : "s"} gevonden.`;
          }
        }

        if (noResults) {
          noResults.style.display = totalVisible === 0 && query.length > 0 ? "block" : "none";
        }
      };

      input.addEventListener("input", updateFilter);
      updateFilter();
    });
  </script>

  <style>
    .hub-search {
      margin-bottom: 1.5rem;
    }

    .hub-search-wrap {
      position: relative;
      max-width: 480px;
      margin: 0 auto;
    }

    .hub-search {
      text-align: center;
    }

    .hub-search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.1rem;
      pointer-events: none;
    }

    .hub-search-input {
      width: 100%;
      padding: 0.9rem 1rem 0.9rem 2.75rem;
      font-size: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-surface);
      color: var(--color-text);
      box-shadow: var(--shadow-sm);
    }

    .hub-search-input:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
      border-color: var(--color-primary);
    }

    .hub-search-hint {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }

    .hub-no-results {
      margin: 1.5rem 0;
      padding: 1rem 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      color: var(--color-text);
    }

    .hub-no-results a {
      color: var(--color-primary);
      font-weight: 600;
    }

    .hub-groups :global(.cat-grid) {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    }

    .pillar-content h3 {
      font-size: 1rem;
      font-weight: 700;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .pillar-content ul {
      margin-left: 1.25rem;
      margin-bottom: 1rem;
    }

    .pillar-content li {
      margin-bottom: 0.35rem;
    }

    .pillar-faq-item {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.85rem 1rem;
      margin-bottom: 0.5rem;
    }

    .pillar-faq-item summary {
      font-weight: 600;
      cursor: pointer;
    }

    .pillar-faq-item p {
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: var(--color-text-muted);
    }

    .pillar-footer {
      font-size: 0.85rem;
      color: var(--color-text-muted);
      text-align: center;
      margin-bottom: 2rem;
    }

    @media (max-width: 560px) {
      .hub-groups :global(.cat-grid) {
        grid-template-columns: 1fr;
      }

      .hub-search-input {
        font-size: 1rem;
      }
    }
  </style>
</BaseLayout>
