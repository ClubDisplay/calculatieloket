---
import ContentHubPage from "../components/calculator/ContentHubPage.astro";
import type { SourceItem, CrossSellItem } from "../components/calculator/ContentHubPage.astro";

const title = "Kindgebonden budget 2026 | Voorwaarden en proefberekening";
const description = "Lees welke gegevens van belang zijn voor kindgebonden budget in 2026 en open de officiële proefberekening van Dienst Toeslagen.";
const h1 = "Kindgebonden budget in 2026";

const intro = [
  "Kindgebonden budget is een bijdrage in de kosten voor kinderen tot 18 jaar. De hoogte hangt onder meer af van je inkomen, vermogen, toeslagpartner en de leeftijd en het aantal kinderen.",
  "Calculatieloket.nl berekent deze toeslag momenteel niet zelf. Voor een bedrag op basis van jouw situatie gebruik je de officiële proefberekening van Dienst Toeslagen.",
];

const sources: SourceItem[] = [
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — voorwaarden kindgebonden budget",
    description: "Voorwaarden over kinderbijslag, inkomen, vermogen en gezinssituatie.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/nl/kindgebonden-budget/content/kan-ik-kindgebonden-budget-krijgen",
  },
  {
    label: "Officiële bron",
    title: "Dienst Toeslagen — berekening 2026",
    description: "De officiële stappen en bedragen voor het berekeningsjaar 2026.",
    href: "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/themaoverstijgend/brochures_en_publicaties/berekening-kindgebonden-budget",
  },
];

const crossSell: CrossSellItem[] = [
  { title: "Huur- en zorgtoeslag", description: "Maak een indicatie van huur- en zorgtoeslag.", href: "/toeslagen-calculator/", accent: "#059669" },
  { title: "Bruto-netto inkomen", description: "Bekijk een indicatie van je nettoloon.", href: "/bruto-netto-2026/", accent: "#2563eb" },
];

const relatedLinks = [
  { href: "/toeslagen-calculator/", label: "Huur- en zorgtoeslag berekenen" },
  { href: "/bruto-netto-2026/", label: "Bruto-netto inkomen berekenen" },
];

const faq = [
  {
    question: "Berekent de toeslagencalculator ook kindgebonden budget?",
    answer: "Nee. Onze toeslagencalculator geeft alleen een indicatie van huurtoeslag en zorgtoeslag. Voor kindgebonden budget verwijzen we naar de officiële proefberekening van Dienst Toeslagen.",
  },
  {
    question: "Welke gegevens heb ik nodig voor de proefberekening?",
    answer: "Houd je geschatte toetsingsinkomen, je vermogen, je gezinssituatie en de geboortedata van je kinderen bij de hand. De officiële proefberekening vraagt de gegevens die voor jouw situatie nodig zijn.",
  },
  {
    question: "Wat als mijn inkomen later verandert?",
    answer: "Een verandering in inkomen kan de toeslag veranderen. Controleer je gegevens dan bij Dienst Toeslagen en geef wijzigingen op tijd door via Mijn toeslagen.",
  },
];

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Toeslagen", href: "/toeslagen-calculator/" },
  { label: "Kindgebonden budget", current: true },
];
---

<ContentHubPage
  title={title}
  description={description}
  h1={h1}
  breadcrumbs={breadcrumbs}
  intro={intro}
  sources={sources}
  faq={faq}
  relatedLinks={relatedLinks}
  crossSell={crossSell}
  lastUpdated="24 september 2026"
  categoryLabel="Toeslagen"
  calculatorCta={{
    href: "https://www.toeslagen.nl/proefberekening",
    title: "Officiële proefberekening openen",
    description: "Bereken bij Dienst Toeslagen een bedrag voor kindgebonden budget op basis van je eigen gegevens.",
  }}
>
  <Fragment slot="content">
    <h2>Wat bepaalt de hoogte?</h2>
    <p>Het bedrag wordt opgebouwd uit bedragen per kind. Voor oudere kinderen en alleenstaande ouders kunnen aanvullende bedragen gelden. Bij een hoger toetsingsinkomen neemt het kindgebonden budget af. Dienst Toeslagen gebruikt de actuele regels voor 2026 in de officiële proefberekening.</p>

    <h2>Controleer eerst je situatie</h2>
    <ul class="calc-list">
      <li><strong>Kinderbijslag:</strong> kijk op wiens naam de kinderbijslag bij de SVB staat.</li>
      <li><strong>Inkomen:</strong> gebruik het verwachte toetsingsinkomen voor het hele jaar, ook van een eventuele toeslagpartner.</li>
      <li><strong>Vermogen:</strong> controleer de vermogensgrens op de peildatum bij Dienst Toeslagen.</li>
      <li><strong>Gezin:</strong> het aantal kinderen, hun leeftijd en een eventuele toeslagpartner beïnvloeden de berekening.</li>
    </ul>
    <p>Co-ouderschap, wonen in het buitenland en andere bijzondere situaties kunnen extra voorwaarden hebben. Gebruik daarom de <a href="https://www.toeslagen.nl/proefberekening" target="_blank" rel="noopener">officiële proefberekening</a> en lees de <a href="https://www.belastingdienst.nl/wps/wcm/connect/nl/kindgebonden-budget/content/kan-ik-kindgebonden-budget-krijgen" target="_blank" rel="noopener">voorwaarden van Dienst Toeslagen</a>.</p>
  </Fragment>
</ContentHubPage>
