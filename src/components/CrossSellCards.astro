---
import { icons } from "../lib/category-icons";

interface Item {
  href: string;
  title: string;
  description: string;
  accent?: string;
}

interface Props {
  title: string;
  items: Item[];
  analyticsCategory?: string;
}

const { title, items, analyticsCategory = "calculator-page" } = Astro.props;
const slugify = (href: string) => href.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");

function iconFor(item: Item): string {
  const key = `${item.title} ${item.href}`.toLowerCase();
  if (key.includes("hypotheek") || key.includes("wonen") || key.includes("huis")) return icons.house;
  if (key.includes("salaris") || key.includes("netto") || key.includes("bruto") || key.includes("loon")) return icons.money;
  if (key.includes("zzp") || key.includes("ondernemen") || key.includes("bedrijf")) return icons.person;
  if (key.includes("auto") || key.includes("import") || key.includes("car")) return icons.car;
  if (key.includes("btw") || key.includes("tarief") || key.includes("percent")) return icons.percent;
  if (key.includes("vakantiegeld") || key.includes("vakantie")) return icons.sun;
  if (key.includes("toeslagen") || key.includes("zorgtoeslag")) return icons.house;
  return icons.calc;
}
---

<section class="xsell">
  <h2 class="xsell-title">{title}</h2>
  <div class="xsell-grid">
    {items.map((item) => (
      <a
        href={item.href}
        class="xsell-card"
        style={item.accent ? `--xsell-accent:${item.accent}` : undefined}
        data-analytics="cross-sell-card"
        data-analytics-category={analyticsCategory}
        data-analytics-action="click"
        data-analytics-label={slugify(item.href)}
      >
        <span class="xsell-icon" aria-hidden="true" set:html={iconFor(item)} />
        <span class="xsell-card-title">{item.title}</span>
        <span class="xsell-card-desc">{item.description}</span>
        <span class="xsell-card-cta">Bekijk <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .xsell {
    margin-top: 2.5rem;
  }

  .xsell-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .xsell-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .xsell-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s, transform 0.15s;
  }

  .xsell-card:hover,
  .xsell-card:focus-visible {
    border-color: var(--xsell-accent, var(--color-primary));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
    transform: translateY(-2px);
  }

  .xsell-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary-light);
    color: var(--xsell-accent, var(--color-primary));
    margin-bottom: 0.25rem;
  }

  .xsell-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .xsell-card-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .xsell-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    flex: 1;
  }

  .xsell-card-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--xsell-accent, var(--color-primary));
    margin-top: 0.25rem;
  }

  @media (max-width: 560px) {
    .xsell-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
