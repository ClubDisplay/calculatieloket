---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import AdSlot from "../AdSlot.astro";
import CrossSellCards from "../CrossSellCards.astro";
import CalculatorShell from "./CalculatorShell.astro";
import InputPanel from "./InputPanel.astro";
import ResultPanel from "./ResultPanel.astro";
import UseCasesPanel from "./UseCasesPanel.astro";
import FaqAccordion from "./FaqAccordion.astro";
import ToolFooter from "./ToolFooter.astro";
import SourceCards from "../SourceCards.astro";
import TrustPanel from "./TrustPanel.astro";
import FinancialJourney from "./FinancialJourney.astro";
import HowToSchema from "./HowToSchema.astro";
import InlineSources from "./InlineSources.astro";
import { calculateBtw } from "../../lib/calculators/btw";
import { getRecommendations } from "../../lib/recommendations/engine";
import { formatEuro } from "../../lib/format/currency";

export interface UseCaseItem {
  id: string;
  title: string;
  description: string;
  template: string;
  href: string;
  accent: string;
}

export interface CrossSellItem {
  href: string;
  title: string;
  description: string;
  accent: string;
}

export interface BreadcrumbItem {
  label: string;
  href?: string;
  current?: boolean;
}

export interface Props {
  title: string;
  description: string;
  pageTitle: string;
  calculatorId: string;
  defaultAmount?: number;
  defaultRate?: 21 | 9 | 0;
  defaultDirection?: "excl" | "incl";
  allowRateSwitch?: boolean;
  allowDirectionSwitch?: boolean;
  lastUpdated?: string;
  quickAmounts?: number[];
  intro: string[];
  content: string;
  faq: Array<{ question: string; answer: string }>;
  useCases: UseCaseItem[];
  crossSell: CrossSellItem[];
  relatedLinks: Array<{ href: string; label: string }>;
  howTo: { name: string; description: string; steps: Array<{ name: string; text: string }> };
  sources: Array<{ label: string; title: string; description: string; href: string }>;
  breadcrumbs: BreadcrumbItem[];
  footerDisclaimer?: string;
  adSlot?: string;
}

const {
  title,
  description,
  pageTitle,
  calculatorId,
  defaultAmount = 100,
  defaultRate = 21,
  defaultDirection = "excl",
  allowRateSwitch = true,
  allowDirectionSwitch = true,
  lastUpdated = "27 juli 2026",
  quickAmounts = [50, 100, 250, 500, 1000],
  intro,
  content,
  faq,
  useCases,
  crossSell,
  relatedLinks,
  howTo,
  sources,
  breadcrumbs,
  footerDisclaimer = "Deze uitkomst is een indicatie op basis van je invoer en de btw-tarieven van 2026. Controleer belangrijke bedragen via officiële bronnen of een adviseur. Aan de uitkomst kunnen geen rechten worden ontleend.",
  adSlot = "1234567890",
} = Astro.props;

const initialResult = calculateBtw({
  amount: defaultAmount,
  rate: defaultRate,
  direction: defaultDirection === "excl" ? "exclusive_to_inclusive" : "inclusive_to_exclusive",
});

const initialRecommendations = getRecommendations({
  calculator: calculatorId,
  values: { amount: defaultAmount, rate: defaultRate, direction: defaultDirection },
  result: initialResult,
});

const heroLabel = defaultDirection === "excl" ? "Bedrag inclusief btw" : "Bedrag exclusief btw";
const heroValue = formatEuro(defaultDirection === "excl" ? initialResult.amountIncl : initialResult.amountExcl, 2);
const heroSubtext = defaultDirection === "excl"
  ? `Dit wordt ${formatEuro(initialResult.amountIncl, 2)} inclusief btw over ${formatEuro(initialResult.amountExcl, 2)} exclusief.`
  : `Dit is ${formatEuro(initialResult.amountExcl, 2)} exclusief btw van ${formatEuro(initialResult.amountIncl, 2)} inclusief.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": item.href ? `https://calculatieloket.nl${item.href}` : undefined,
  })),
};

const defaultRateLabel = `${defaultRate}%`;
---

<BaseLayout title={title} description={description} containerClass="container-wide">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <HowToSchema slot="head" name={howTo.name} description={howTo.description} totalTime="PT30S" steps={howTo.steps} />

  <AdSlot slot={adSlot} format="auto" style="min-height:100px" />

  <Breadcrumbs items={breadcrumbs} />

  <div
    data-btw-calculator
    data-calculator-id={calculatorId}
    data-default-rate={defaultRate}
    data-default-direction={defaultDirection}
    data-allow-rate-switch={allowRateSwitch}
    data-allow-direction-switch={allowDirectionSwitch}
  >
    <CalculatorShell title={pageTitle} subtitle={intro[0]}>
      <InputPanel title="Jouw bedrag" slot="input">
        <div class="form-group">
          <label for="amount">Bedrag</label>
          <div class="input-prefix">
            <span class="prefix">&euro;</span>
            <input type="number" id="amount" value={defaultAmount} min="0" step="0.01" />
          </div>
        </div>

        <div class="quick-chips" role="group" aria-labelledby="quickChipsLabel">
          <span class="quick-chips-label" id="quickChipsLabel">Snel kiezen:</span>
          {quickAmounts.map((amount) => (
            <button type="button" class="quick-chip" data-amount={amount} data-analytics="quick-chip" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label={amount}>
              &euro; {amount.toLocaleString("nl-NL")}
            </button>
          ))}
        </div>

        <div class="form-group" id="rateGroup" style={allowRateSwitch ? undefined : "display:none"}>
          <label>BTW-tarief</label>
          <div class="radio-group" id="btwRate" role="group" aria-label="BTW-tarief">
            <button type="button" data-rate="21" class={defaultRate === 21 ? "active" : ""} aria-pressed={defaultRate === 21 ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="rate-21">21%</button>
            <button type="button" data-rate="9" class={defaultRate === 9 ? "active" : ""} aria-pressed={defaultRate === 9 ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="rate-9">9%</button>
            <button type="button" data-rate="0" class={defaultRate === 0 ? "active" : ""} aria-pressed={defaultRate === 0 ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="rate-0">0%</button>
          </div>
          <p class="btw-nul-waarschuwing" id="btwRateHint">0% btw geldt alleen in specifieke situaties, zoals internationale handel. Controleer altijd of je dit tarief mag toepassen.</p>
        </div>

        <div class="form-group" id="rateFixedGroup" style={allowRateSwitch ? "display:none" : undefined}>
          <label>BTW-tarief</label>
          <div class="radio-group radio-group-fixed" role="group" aria-label="BTW-tarief">
            <button type="button" class="active" aria-pressed="true" data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label={`rate-${defaultRate}`}>{defaultRateLabel}</button>
          </div>
        </div>

        <div class="form-group" id="directionGroup" style={allowDirectionSwitch ? undefined : "display:none"}>
          <label>Bereken</label>
          <div class="radio-group" id="btwDirection" role="group" aria-label="Berekenrichting">
            <button type="button" data-direction="excl" class={defaultDirection === "excl" ? "active" : ""} aria-pressed={defaultDirection === "excl" ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="direction-excl">Exclusief &rarr; inclusief</button>
            <button type="button" data-direction="incl" class={defaultDirection === "incl" ? "active" : ""} aria-pressed={defaultDirection === "incl" ? "true" : "false"} data-analytics="radio-button" data-analytics-category="calculator-page" data-analytics-action="select" data-analytics-label="direction-incl">Inclusief &rarr; exclusief</button>
          </div>
        </div>

        <p class="calc-live-status" aria-live="polite">Resultaat wordt automatisch bijgewerkt.</p>
        <p class="calc-error" id="calcError" style="display:none;">Vul een geldig bedrag in (0 of hoger).</p>
      </InputPanel>

      <ResultPanel
        slot="result"
        title="BTW resultaat"
        heroLabel={heroLabel}
        heroValue={heroValue}
        heroSubtext={heroSubtext}
        badge="Indicatie"
      >
        <div class="result-meta">
          <span class="meta-badge">Bijgewerkt: 2026</span>
          <span class="meta-badge">Bron: Belastingdienst</span>
        </div>

        <div class="result-row"><span class="label">Bedrag exclusief btw</span><span class="value" id="detailExcl">{formatEuro(initialResult.amountExcl, 2)}</span></div>
        <div class="result-row"><span class="label">Btw-bedrag</span><span class="value" id="detailBtw">{formatEuro(initialResult.btwAmount, 2)}</span></div>
        <div class="result-row"><span class="label">Bedrag inclusief btw</span><span class="value" id="detailIncl">{formatEuro(initialResult.amountIncl, 2)}</span></div>
        <div class="result-divider"></div>
        <div class="result-row"><span class="label">Gebruikt tarief</span><span class="value" id="detailRate">{`${initialResult.rate}% btw`}</span></div>

        <FinancialJourney recommendations={initialRecommendations} />
        <InlineSources title="Gebruikte bronnen" items={sources} />

        <button class="copy-link-btn" id="copyLinkBtn" type="button" slot="actions" data-analytics="copy-link" data-analytics-category="calculator-page" data-analytics-action="click" data-analytics-label="copy-link" aria-label="Deel deze berekening">
          <span class="copy-link-icon" aria-hidden="true">🔗</span>
          <span class="copy-link-text">Deel deze berekening</span>
        </button>
      </ResultPanel>

      <TrustPanel slot="result" lastUpdated={lastUpdated} sourcesId="calculator-sources" />

      <UseCasesPanel title="Wat kun je hiermee?" items={useCases} slot="useCases" />

      <SourceCards id="calculator-sources" title="Bronnen" items={sources} slot="sources" />

      <FaqAccordion title="Veelgestelde vragen" items={faq} slot="faq" />

      <ToolFooter categoryLink="/categorie/belasting/" categoryLabel="Belasting"
        slot="footer"
        disclaimer={footerDisclaimer}
        lastUpdated={lastUpdated}
      />
    </CalculatorShell>

    <div class="calculator-card calc-content" id="calculator-content">
      <h2 class="page-title">{pageTitle}</h2>
      {intro.slice(1).map((paragraph) => (
        <p set:html={paragraph} />
      ))}
      <div set:html={content} />
    </div>

    <div class="calculator-card calc-content">
      <h2>Ook handig binnen btw</h2>
      <ul class="calc-list">
        {relatedLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <CrossSellCards title="Andere calculators die je helpen" items={crossSell} />
</BaseLayout>

<script>
  import { calculateBtw } from "../../lib/calculators/btw";
  import { formatEuro } from "../../lib/format/currency";
  import { fillTemplate } from "../../lib/format/template";
  import { getRecommendations } from "../../lib/recommendations/engine";
  import { updateFinancialJourney } from "../../lib/recommendations/client";

  const wrapper = document.querySelector("[data-btw-calculator]") as HTMLElement;
  if (!wrapper) throw new Error("BTW calculator wrapper not found");

  const calculatorId = wrapper.dataset.calculatorId!;
  const defaultRate = parseInt(wrapper.dataset.defaultRate!, 10);
  const defaultDirection = wrapper.dataset.defaultDirection as "excl" | "incl";
  const allowRateSwitch = wrapper.dataset.allowRateSwitch !== "false";
  const allowDirectionSwitch = wrapper.dataset.allowDirectionSwitch !== "false";

  const amountInput = document.getElementById("amount") as HTMLInputElement;
  const hero = document.querySelector("[data-calc-result-hero]") as HTMLElement;
  const heroLabel = document.querySelector(".calc-result-panel-label") as HTMLElement;
  const heroSubtext = document.querySelector(".calc-result-panel-subtext") as HTMLElement;
  const errorBox = document.getElementById("calcError") as HTMLElement;
  const copyLinkBtn = document.getElementById("copyLinkBtn") as HTMLButtonElement;
  const financialJourney = document.querySelector(".calc-financial-journey") as HTMLElement;

  const detailExcl = document.getElementById("detailExcl")!;
  const detailBtw = document.getElementById("detailBtw")!;
  const detailIncl = document.getElementById("detailIncl")!;
  const detailRate = document.getElementById("detailRate")!;

  let rate = defaultRate;
  let direction: "excl" | "incl" = defaultDirection;

  function updateUseCases(amount: number, direction: "excl" | "incl", result: { amountExcl: number; amountIncl: number; btwAmount: number }) {
    const incl = direction === "excl" ? result.amountIncl : amount;

    document.querySelectorAll("[data-usecase]").forEach((card) => {
      const id = card.getAttribute("data-usecase");
      const desc = card.querySelector(".calc-use-cases-card-desc") as HTMLElement;
      if (!desc) return;
      const template = desc.dataset.template;
      const fallback = desc.dataset.fallback || desc.textContent || "";
      if (!template || template === fallback) return;
      desc.textContent = fillTemplate(template, {
        bedrag: formatEuro(amount, 2),
        btw: formatEuro(result.btwAmount, 2),
        excl: formatEuro(result.amountExcl, 2),
        incl: formatEuro(incl, 2),
      }, fallback);

      const anchor = card as HTMLAnchorElement;
      if (id === "terugrekenen") {
        anchor.href = `/btw-terugrekenen/?bedrag=${incl}&tarief=${rate}&richting=incl`;
      } else if (id === "inclusief-exclusief") {
        anchor.href = `/btw-inclusief-exclusief/?bedrag=${amount}&tarief=${rate}&richting=${direction}`;
      } else if (id === "btw-21-procent") {
        anchor.href = `/btw-21-procent-berekenen/?bedrag=${amount}&richting=${direction}`;
      } else if (id === "btw-9-procent") {
        anchor.href = `/btw-9-procent-berekenen/?bedrag=${amount}&richting=${direction}`;
      }
    });
  }

  function updateUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = parseFloat(amountInput.value) || 0;

    if (amount > 0) params.set("bedrag", amount.toString());
    else params.delete("bedrag");

    params.set("tarief", rate.toString());
    params.set("richting", direction);

    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState(null, "", newUrl);
  }

  function calculate() {
    const amount = parseFloat(amountInput.value);
    const engineDirection = direction === "excl" ? "exclusive_to_inclusive" : "inclusive_to_exclusive";
    const result = calculateBtw({ amount, rate, direction: engineDirection });

    if (!result.valid) {
      errorBox.style.display = "block";
      hero.textContent = "—";
      detailExcl.textContent = "—";
      detailBtw.textContent = "—";
      detailIncl.textContent = "—";
      detailRate.textContent = "—";
      return;
    }

    errorBox.style.display = "none";

    hero.textContent = formatEuro(direction === "excl" ? result.amountIncl : result.amountExcl, 2);
    heroLabel.textContent = direction === "excl" ? "Bedrag inclusief btw" : "Bedrag exclusief btw";
    heroSubtext.textContent = direction === "excl"
      ? `Dit wordt ${formatEuro(result.amountIncl, 2)} inclusief btw over ${formatEuro(result.amountExcl, 2)} exclusief.`
      : `Dit is ${formatEuro(result.amountExcl, 2)} exclusief btw van ${formatEuro(result.amountIncl, 2)} inclusief.`;

    detailExcl.textContent = formatEuro(result.amountExcl, 2);
    detailBtw.textContent = formatEuro(result.btwAmount, 2);
    detailIncl.textContent = formatEuro(result.amountIncl, 2);
    detailRate.textContent = `${result.rate}% btw`;

    updateUseCases(amount, direction, result);
    if (financialJourney) {
      const recs = getRecommendations({
        calculator: calculatorId,
        values: { amount, rate, direction },
        result,
      });
      updateFinancialJourney(financialJourney, recs);
    }
    updateUrl();
  }

  function applyUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const bedrag = params.get("bedrag");
    const tarief = params.get("tarief");
    const richting = params.get("richting");

    if (bedrag !== null) amountInput.value = bedrag;
    if (tarief !== null && allowRateSwitch) {
      rate = parseInt(tarief, 10);
      document.querySelectorAll("#btwRate button").forEach((btn) => {
        const button = btn as HTMLButtonElement;
        const isActive = button.dataset.rate === tarief;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }
    if (richting !== null && (richting === "excl" || richting === "incl") && allowDirectionSwitch) {
      direction = richting;
      document.querySelectorAll("#btwDirection button").forEach((btn) => {
        const button = btn as HTMLButtonElement;
        const isActive = button.dataset.direction === richting;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }
  }

  function initQuickChips() {
    document.querySelectorAll(".quick-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        const amount = (btn as HTMLElement).dataset.amount;
        if (amount) {
          amountInput.value = amount;
          amountInput.focus();
          calculate();
        }
      });
    });
  }

  function initCopyLink() {
    copyLinkBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const textEl = copyLinkBtn.querySelector(".copy-link-text") as HTMLElement;
        const originalText = textEl.textContent || "Deel deze berekening";
        textEl.textContent = "Link gekopieerd";
        copyLinkBtn.classList.add("copy-link-success");
        setTimeout(() => {
          textEl.textContent = originalText;
          copyLinkBtn.classList.remove("copy-link-success");
        }, 2000);
      } catch (err) {
        console.error("Kon link niet kopiëren", err);
      }
    });
  }

  function initRateButtons() {
    if (!allowRateSwitch) return;
    document.getElementById("btwRate")!.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button") as HTMLButtonElement | null;
      if (!btn) return;
      document.querySelectorAll("#btwRate button").forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-pressed", "true");
      rate = parseInt(btn.dataset.rate!, 10);
      calculate();
    });
  }

  function initDirectionButtons() {
    if (!allowDirectionSwitch) return;
    document.getElementById("btwDirection")!.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button") as HTMLButtonElement | null;
      if (!btn) return;
      document.querySelectorAll("#btwDirection button").forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-pressed", "true");
      direction = btn.dataset.direction as "excl" | "incl";
      calculate();
    });
  }

  applyUrlParams();
  calculate();
  initQuickChips();
  initCopyLink();
  initRateButtons();
  initDirectionButtons();

  amountInput.addEventListener("input", calculate);
  amountInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      calculate();
      amountInput.blur();
    }
  });
</script>

<style>
  .calc-content {
    padding: 1.5rem;
  }

  .calc-content h2,
  .calc-content .page-title,
  .calc-content :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .calc-content .page-title,
  .calc-content :global(.page-title) {
    font-size: 1.75rem;
    margin-top: 0;
  }

  .calc-content h3,
  .calc-content :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .calc-content p,
  .calc-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .calc-content a,
  .calc-content :global(a) {
    text-decoration: underline;
  }

  .calc-content a:hover,
  .calc-content :global(a:hover) {
    text-decoration: none;
  }

  .calc-content ul,
  .calc-content :global(ul) {
    margin-left: 1.25rem;
    margin-bottom: 1rem;
  }

  .calc-content li,
  .calc-content :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .calc-content :global(.rate-table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
  }

  .calc-content :global(.rate-table th),
  .calc-content :global(.rate-table td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border: 1px solid var(--color-border);
  }

  .calc-content :global(.rate-table th) {
    background: var(--color-primary-light);
    font-weight: 700;
  }

  .calc-content :global(.rate-table tr:nth-child(even)) {
    background: var(--color-surface);
  }

  .calc-content :global(.formula-box) {
    background: var(--color-primary-light);
    border: 1px solid #bfdbfe;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }

  .calc-content :global(.formula-box p) {
    margin: 0.25rem 0;
    font-size: 0.95rem;
  }

  .calc-error {
    color: #b91c1c;
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .meta-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
  }

  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .result-row .label {
    color: var(--color-text-muted);
  }

  .result-row .value {
    font-weight: 600;
    color: var(--color-text);
  }

  .result-divider {
    height: 1px;
    background: var(--color-border);
    margin: 0.35rem 0;
  }

  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: -0.25rem 0 0.75rem;
  }

  .quick-chips-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .quick-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
