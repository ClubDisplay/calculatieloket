---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="calc-input-panel">
  {title && <h2 class="calc-input-panel-title">{title}</h2>}
  <div class="calc-input-panel-body">
    <slot />
  </div>
</div>

<style is:global>
  .calc-input-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  .calc-input-panel-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .calc-input-panel-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .calc-input-panel .form-group {
    margin-bottom: 0;
  }

  .calc-input-panel .form-group label {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .calc-input-panel .form-group .hint {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 400;
    margin-top: 0.35rem;
  }

  .calc-input-panel input[type="number"],
  .calc-input-panel input[type="text"],
  .calc-input-panel select {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
    font-family: var(--font);
    border: 1.5px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    -moz-appearance: textfield;
  }

  .calc-input-panel input[type="number"]::-webkit-outer-spin-button,
  .calc-input-panel input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .calc-input-panel input[type="number"]:hover,
  .calc-input-panel input[type="text"]:hover,
  .calc-input-panel select:hover {
    border-color: #cbd5e1;
  }

  .calc-input-panel input[type="number"]:focus,
  .calc-input-panel input[type="text"]:focus,
  .calc-input-panel select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .calc-input-panel .input-prefix input {
    padding-left: 2.75rem;
  }

  .calc-input-panel .input-prefix .prefix {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    font-weight: 600;
    pointer-events: none;
  }

  .calc-input-panel .input-suffix input {
    padding-right: 3.25rem;
  }

  .calc-input-panel .input-suffix .suffix {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    color: var(--color-text-muted);
    font-weight: 600;
    pointer-events: none;
  }

  .calc-input-panel .radio-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .calc-input-panel .radio-group button {
    flex: 1 1 auto;
    min-width: 80px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font);
    font-weight: 600;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .calc-input-panel .radio-group button:hover,
  .calc-input-panel .radio-group button:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .calc-input-panel .radio-group button.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
  }

  .calc-input-panel .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .calc-input-panel .toggle-row .toggle-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .calc-input-panel .quick-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: -0.5rem 0 0.5rem;
  }

  .calc-input-panel .quick-chips-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .calc-input-panel .quick-chip {
    appearance: none;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.15s;
  }

  .calc-input-panel .quick-chip:hover,
  .calc-input-panel .quick-chip:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .calc-input-panel .calc-error {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #991b1b;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0;
    padding: 0.75rem 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
  }

  .calc-input-panel .calc-error::before {
    content: "⚠";
    font-size: 1rem;
    flex-shrink: 0;
  }

  .calc-input-panel .btn-primary {
    width: 100%;
  }

  @media (max-width: 480px) {
    .calc-input-panel {
      padding: 1.25rem;
      border-radius: 18px;
    }

    .calc-input-panel input[type="number"],
    .calc-input-panel input[type="text"],
    .calc-input-panel select {
      font-size: 16px;
      padding: 0.8rem 0.95rem;
    }

    .calc-input-panel .radio-group {
      flex-direction: column;
    }

    .calc-input-panel .radio-group button {
      width: 100%;
    }
  }
</style>
