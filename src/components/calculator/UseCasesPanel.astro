---
import { icons } from "../../lib/category-icons";

interface Item {
  title: string;
  description: string;
  href: string;
  accent?: string;
  id?: string;
  template?: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = "Wat kun je hiermee?", items } = Astro.props;
const slugify = (href: string) => href.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");

function iconFor(item: Item): string {
  const key = `${item.id || ""} ${item.title} ${item.href}`.toLowerCase();
  if (key.includes("hypotheek") || key.includes("wonen") || key.includes("huis") || key.includes("toeslagen")) return icons.house;
  if (key.includes("salaris") || key.includes("netto") || key.includes("bruto") || key.includes("loon")) return icons.money;
  if (key.includes("zzp") || key.includes("ondernemen") || key.includes("bedrijf")) return icons.person;
  if (key.includes("auto") || key.includes("import") || key.includes("car")) return icons.car;
  if (key.includes("btw") || key.includes("tarief") || key.includes("percent")) return icons.percent;
  if (key.includes("vakantiegeld") || key.includes("vakantie")) return icons.sun;
  return icons.calc;
}
---

<section class="calc-use-cases">
  <h2 class="calc-use-cases-title">{title}</h2>
  <div class="calc-use-cases-grid">
    {items.map((item) => (
      <a
        href={item.href}
        class="calc-use-cases-card"
        data-usecase={item.id}
        style={item.accent ? `--uc-accent: ${item.accent}` : undefined}
        data-analytics="use-case-link"
        data-analytics-category="calculator-page"
        data-analytics-action="click"
        data-analytics-label={item.id || slugify(item.href)}
      >
        <span class="calc-use-cases-icon" aria-hidden="true" set:html={iconFor(item)} />
        <span class="calc-use-cases-card-title">{item.title}</span>
        <span class="calc-use-cases-card-desc" data-template={item.template || item.description} data-fallback={item.description}>{item.description}</span>
        <span class="calc-use-cases-card-cta">Bekijk <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .calc-use-cases-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .calc-use-cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .calc-use-cases-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .calc-use-cases-card:hover,
  .calc-use-cases-card:focus-visible {
    border-color: var(--uc-accent, var(--color-primary));
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .calc-use-cases-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary-light);
    color: var(--uc-accent, var(--color-primary));
    margin-bottom: 0.25rem;
  }

  .calc-use-cases-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .calc-use-cases-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .calc-use-cases-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    flex: 1;
  }

  .calc-use-cases-card-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--uc-accent, var(--color-primary));
    margin-top: 0.25rem;
  }
</style>
