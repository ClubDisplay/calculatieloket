---
import { icons } from "../../lib/category-icons";

interface Step {
  id: string;
  label: string;
  description: string;
  href: string;
}

interface Recommendation {
  id: string;
  title: string;
  description: string;
  url: string;
  priority: number;
  reason: string;
}

interface Props {
  title?: string;
  steps?: Step[];
  recommendations?: Recommendation[];
  income?: number;
  partnerIncome?: number;
  totalIncome?: number;
  rent?: number;
  isCouple?: boolean;
}

const {
  title = "Wat wil je daarna doen?",
  steps: customSteps,
  recommendations,
  income = 0,
  partnerIncome = 0,
  totalIncome = 0,
  rent = 0,
  isCouple = false,
} = Astro.props;

const primaryIncome = income;
const brutoMonthly = primaryIncome > 0 ? Math.round(primaryIncome / 12) : 0;
const totalIncomeValue = totalIncome > 0 ? totalIncome : primaryIncome + partnerIncome;

const defaultSteps: Step[] = [
  {
    id: "netto",
    label: "Netto salaris berekenen",
    description: "Bereken je netto loon bij dit inkomen.",
    href: brutoMonthly > 0 ? `/salaris-calculator/?bruto=${brutoMonthly}` : "/salaris-calculator/",
  },
  {
    id: "hypotheek",
    label: "Hypotheek berekenen",
    description: "Bekijk hoeveel je kunt lenen.",
    href:
      totalIncomeValue > 0
        ? `/hypotheek-calculator/?inkomen=${totalIncomeValue}&partner=${isCouple ? 1 : 0}&partnerInkomen=${partnerIncome}`
        : "/hypotheek-calculator/",
  },
  {
    id: "zzp",
    label: "ZZP vergelijken",
    description: "Bereken je benodigde uurtarief.",
    href: "/zzp-calculator/",
  },
  {
    id: "vakantiegeld",
    label: "Vakantiegeld berekenen",
    description: "Bereken je netto vakantiegeld.",
    href: "/vakantiegeld-calculator/",
  },
];

const steps = customSteps ?? defaultSteps;
const MAX_RECOMMENDATIONS = 4;
const displayRecommendations = recommendations?.slice(0, MAX_RECOMMENDATIONS);

function iconFor(id: string | undefined, title: string): string {
  const key = `${id || ""} ${title}`.toLowerCase();
  if (key.includes("vakantiegeld") || key.includes("vakantie") || key.includes("vakantie")) return icons.sun;
  if (key.includes("hypotheek") || key.includes("wonen") || key.includes("huis")) return icons.house;
  if (key.includes("salaris") || key.includes("netto") || key.includes("bruto") || key.includes("loon")) return icons.money;
  if (key.includes("zzp") || key.includes("ondernemen") || key.includes("bedrijf") || key.includes("zzp'er")) return icons.person;
  if (key.includes("auto") || key.includes("import") || key.includes("car") || key.includes("voertuig")) return icons.car;
  if (key.includes("btw") || key.includes("tarief") || key.includes("percent") || key.includes("percentage")) return icons.percent;
  if (key.includes("toeslagen") || key.includes("zorgtoeslag") || key.includes("huurtoeslag")) return icons.house;
  return icons.calc;
}
---

<div
  class="calc-financial-journey"
  data-income={income}
  data-partner-income={partnerIncome}
  data-total-income={totalIncome}
  data-rent={rent}
  data-couple={isCouple}
>
  <h3 class="calc-financial-journey-title">{title}</h3>
  <div class="calc-financial-journey-steps">
    {
      displayRecommendations && displayRecommendations.length > 0 ? (
        displayRecommendations.map((rec) => (
          <a
            href={rec.url}
            class="calc-financial-journey-step"
            data-step={rec.id}
            data-analytics="financial-journey-link"
            data-analytics-category="calculator-page"
            data-analytics-action="click"
            data-analytics-label={rec.id}
          >
            <span class="step-icon" aria-hidden="true" set:html={iconFor(rec.id, rec.title)} />
            <span class="step-content">
              <span class="step-label">{rec.title}</span>
              <span class="step-desc">{rec.description}</span>
              {rec.reason && <span class="step-reason">{rec.reason}</span>}
            </span>
            <span class="step-arrow" aria-hidden="true">→</span>
          </a>
        ))
      ) : (
        steps.map((step) => (
          <a
            href={step.href}
            class="calc-financial-journey-step"
            data-step={step.id}
            data-analytics="financial-journey-link"
            data-analytics-category="calculator-page"
            data-analytics-action="click"
            data-analytics-label={step.id}
          >
            <span class="step-icon" aria-hidden="true" set:html={iconFor(step.id, step.label)} />
            <span class="step-content">
              <span class="step-label">{step.label}</span>
              <span class="step-desc">{step.description}</span>
            </span>
            <span class="step-arrow" aria-hidden="true">→</span>
          </a>
        ))
      )
    }
  </div>
</div>

<style is:global>
  .calc-financial-journey {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .calc-financial-journey-title {
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .calc-financial-journey-steps {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .calc-financial-journey-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
    border: 1px solid transparent;
  }

  .calc-financial-journey-step:hover,
  .calc-financial-journey-step:focus-visible {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
  }

  .step-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .step-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .step-label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .step-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .step-reason {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .step-arrow {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    transition: transform 0.15s, color 0.15s;
  }

  .calc-financial-journey-step:hover .step-arrow,
  .calc-financial-journey-step:focus-visible .step-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }
</style>
