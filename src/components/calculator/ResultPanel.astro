---
interface Props {
  title?: string;
  heroValue: string;
  heroLabel?: string;
  heroSubtext?: string;
  badge?: string;
}

const { title, heroValue, heroLabel = "Resultaat", heroSubtext, badge = "Indicatie" } = Astro.props;
---

<div class="calc-result-panel">
  {title && <h2 class="calc-result-panel-title">{title}</h2>}

  <div class="calc-result-panel-header">
    <span class="calc-result-panel-label">{heroLabel}</span>
    {badge && <span class="calc-result-panel-badge">{badge}</span>}
  </div>

  <div class="calc-result-panel-hero" data-calc-result-hero>{heroValue}</div>
  {heroSubtext && <p class="calc-result-panel-subtext">{heroSubtext}</p>}

  <div class="calc-result-panel-breakdown">
    <slot />
  </div>

  <div class="calc-result-panel-actions">
    <slot name="actions" />
  </div>
</div>

<style is:global>
  .calc-result-panel {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  .calc-result-panel-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .calc-result-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .calc-result-panel-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .calc-result-panel-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .calc-result-panel-hero {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0.25rem 0 0.5rem;
  }

  .calc-result-panel-subtext {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .calc-result-panel-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.95rem;
  }

  .calc-result-panel .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  .calc-result-panel .result-row:last-child {
    border-bottom: none;
  }

  .calc-result-panel .result-row .label {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .calc-result-panel .result-row .value {
    font-weight: 700;
    color: var(--color-text);
  }

  .calc-result-panel .result-row-total .label,
  .calc-result-panel .result-row-total .value {
    font-weight: 800;
    color: var(--color-text);
  }

  .calc-result-panel .result-row-total .value {
    color: var(--color-primary);
  }

  .calc-result-panel .result-divider {
    height: 1px;
    background: var(--color-border);
    margin: 0.5rem 0;
    border: none;
  }

  .calc-result-panel .result-brackets,
  .calc-result-panel .result-comparison {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }

  .calc-result-panel .result-brackets-title,
  .calc-result-panel .result-comparison-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .calc-result-panel .result-bracket-row,
  .calc-result-panel .result-comparison .result-row {
    font-size: 0.9rem;
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .calc-result-panel .result-bracket-row:last-child,
  .calc-result-panel .result-comparison .result-row:last-child {
    border-bottom: none;
  }

  .calc-result-panel .result-comparison .result-row-total .value {
    color: var(--color-primary);
  }

  .calc-result-panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .calc-result-panel .copy-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-surface);
    border: 1.5px solid var(--color-primary);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .calc-result-panel .copy-link-btn:hover,
  .calc-result-panel .copy-link-btn:focus-visible {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .calc-result-panel .copy-link-success {
    background: #dcfce7 !important;
    color: #166534 !important;
    border-color: #166534 !important;
  }

  /* Result reveal animation (triggered once per session via calc-result-reveal) */
  .calc-result-panel.calc-result-reveal {
    animation: resultReveal 0.2s ease-out;
  }

  .calc-result-panel.calc-result-reveal .calc-result-panel-hero {
    animation: resultHeroPulse 0.2s ease-out;
  }

  @keyframes resultReveal {
    from {
      opacity: 0.85;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes resultHeroPulse {
    from {
      transform: scale(0.98);
    }
    to {
      transform: scale(1);
    }
  }

  @media (max-width: 480px) {
    .calc-result-panel {
      padding: 1.25rem;
      border-radius: 18px;
    }

    .calc-result-panel-hero {
      font-size: clamp(2rem, 9vw, 2.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .calc-result-panel.calc-result-reveal,
    .calc-result-panel.calc-result-reveal .calc-result-panel-hero {
      animation: none;
      transform: none;
    }
  }
</style>
