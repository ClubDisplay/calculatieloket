---
interface Item {
  label: string;
  title: string;
  description: string;
  href: string;
}

interface Props {
  title: string;
  items: Item[];
  id?: string;
}

const { title, items, id } = Astro.props;

const documentIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`;
---

<section class="srcc" id={id}>
  <h2 class="srcc-title">{title}</h2>
  <div class="srcc-grid">
    {items.map((item) => (
      <a href={item.href} target="_blank" rel="noopener" class="srcc-card">
        <span class="srcc-icon" aria-hidden="true" set:html={documentIcon} />
        <span class="srcc-content">
          <span class="srcc-label">{item.label}</span>
          <span class="srcc-card-title">{item.title}</span>
          <span class="srcc-desc">{item.description}</span>
        </span>
        <span class="srcc-cta">Bekijk de bron <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .srcc {
    margin-top: 1.5rem;
  }

  .srcc-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .srcc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
  }

  .srcc-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s, transform 0.15s;
  }

  .srcc-card:hover,
  .srcc-card:focus-visible {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
    transform: translateY(-1px);
  }

  .srcc-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .srcc-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .srcc-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .srcc-label {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .srcc-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .srcc-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .srcc-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 0.5rem;
  }

  @media (max-width: 560px) {
    .srcc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
