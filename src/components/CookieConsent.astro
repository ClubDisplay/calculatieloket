---
// Waarschuwing als Cookiebot CMP niet is geconfigureerd.
// De werkelijke Cookiebot-tag en consent-logica staan in BaseLayout.astro in de <head>.
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === "true";
const cookiebotId = import.meta.env.PUBLIC_COOKIEBOT_ID;
---

{adsEnabled && !cookiebotId && (
  <div class="cookie-warning">
    <p>
      <strong>AdSense compliance:</strong> PUBLIC_COOKIEBOT_ID ontbreekt. Voor AdSense in de EER/VK/Zwitserland is een Google-gecertificeerde CMP verplicht. Maak een Cookiebot-account aan en voeg het ID toe aan je environment.
    </p>
  </div>
)}

<style>
  .cookie-warning {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #fff7ed;
    border-top: 2px solid #f97316;
    padding: 1rem 1.25rem;
    text-align: center;
    font-size: 0.9rem;
    color: #7c2d12;
  }
</style>
