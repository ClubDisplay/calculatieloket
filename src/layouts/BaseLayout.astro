---
import ClientRouter from "astro/components/ClientRouter.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { getCategoryList } from "../lib/calculators/registry";

const { title, description } = Astro.props;
const categoryList = getCategoryList();
const containerClass = Astro.props.containerClass ?? "container";
const noindex = Astro.props.noindex ?? false;
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID;
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === "true";
const canonical = new URL(Astro.url.pathname, "https://calculatieloket.nl").href;
const pathname = Astro.url.pathname;
const isCurrentPage = (href: string) => {
  if (href === "/") return pathname === "/";
  const base = href.replace(/\/+$/, "");
  return pathname === base + "/" || pathname.startsWith(base + "/");
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Calculatieloket.nl",
  url: "https://calculatieloket.nl",
  description: "Gratis online calculators voor BTW, salaris, hypotheek en meer. Snel, duidelijk en eenvoudig.",
  inLanguage: "nl-NL",
  publisher: {
    "@type": "Organization",
    name: "Calculatieloket.nl",
      logo: {
        "@type": "ImageObject",
        url: "https://calculatieloket.nl/logo_Calculatieloket-og.png",
      },
  },
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="google-site-verification" content="TRZKC7ND9bcmpINNlT34pqz7ZpoI5C_xIXV-Ypg903c" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <slot name="head" />

    <script is:inline>
      if (location.hostname.includes("pages.dev")) {
        const meta = document.createElement("meta");
        meta.name = "robots";
        meta.content = "noindex";
        document.head.appendChild(meta);
      }
    </script>

    <ClientRouter />

    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Calculatieloket.nl" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content="https://calculatieloket.nl/og-1200x630.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Calculatieloket.nl — gratis online calculators voor salaris, btw, hypotheek en toeslagen" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://calculatieloket.nl/og-1200x630.png" />
    <meta name="twitter:image:alt" content="Calculatieloket.nl — gratis online calculators voor salaris, btw, hypotheek en toeslagen" />

    {adsEnabled && (
      <>
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
        <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
        <link rel="preconnect" href="https://tpc.googlesyndication.com" />
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Spring naar inhoud</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a
          href="/"
          class="site-brand"
          aria-label="Calculatieloket.nl home"
          data-analytics="header-link"
          data-analytics-category="header"
          data-analytics-action="click"
          data-analytics-label="home"
        >
          <img
            src="/logo-calculatieloket-header.png"
            alt="Calculatieloket.nl"
            class="site-logo"
            width="560"
            height="145"
            loading="eager"
            decoding="async"
          />
        </a>

        <button
          class="site-nav-toggle"
          id="siteNavToggle"
          type="button"
          aria-expanded="false"
          aria-controls="siteNavMenu"
          aria-label="Menu openen"
          data-analytics="header-menu-toggle"
          data-analytics-category="header"
          data-analytics-action="click"
          data-analytics-label="menu"
        >
          <span class="site-nav-burger" aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="siteNavMenu" aria-label="Hoofdnavigatie">
          <a
            href="/"
            class="site-nav-link"
            aria-current={isCurrentPage("/") ? "page" : undefined}
            data-analytics="header-link"
            data-analytics-category="header"
            data-analytics-action="click"
            data-analytics-label="home"
          >
            Home
          </a>

          <div class="site-nav-dropdown" data-nav="calculators">
            <button
              type="button"
              class="site-nav-dropdown-toggle"
              id="calcDropdownToggle"
              aria-expanded="false"
              aria-controls="calcDropdownMenu"
              aria-haspopup="menu"
              data-analytics="header-dropdown-toggle"
              data-analytics-category="header"
              data-analytics-action="click"
              data-analytics-label="calculators"
            >
              Calculators
            </button>
            <div
              class="site-nav-dropdown-menu site-nav-megamenu"
              id="calcDropdownMenu"
              role="menu"
              aria-label="Calculators submenu"
            >
              <div class="megamenu-col" role="group" aria-label="Ontdekken">
                <h3 class="megamenu-title">Ontdekken</h3>
                <a
                  href="/calculators/"
                  class="site-nav-dropdown-link"
                  aria-current={isCurrentPage("/calculators/") ? "page" : undefined}
                  data-analytics="header-link"
                  data-analytics-category="header"
                  data-analytics-action="click"
                  data-analytics-label="popular-calculators"
                >
                  Populaire calculators
                </a>
                <a
                  href="/calculators/"
                  class="site-nav-dropdown-link"
                  aria-current={isCurrentPage("/calculators/") ? "page" : undefined}
                  data-analytics="header-link"
                  data-analytics-category="header"
                  data-analytics-action="click"
                  data-analytics-label="new-calculators"
                >
                  Nieuw
                </a>
                <span class="site-nav-dropdown-link site-nav-placeholder" aria-disabled="true">
                  Calculator Explorer (binnenkort)
                </span>
              </div>
              <div class="megamenu-col" role="group" aria-label="Alle categorieën">
                <h3 class="megamenu-title">Alle categorieën</h3>
                {categoryList.map((cat) => (
                  <a
                    href={cat.href}
                    class="site-nav-dropdown-link"
                    aria-current={isCurrentPage(cat.href) ? "page" : undefined}
                    data-analytics="header-link"
                    data-analytics-category="header"
                    data-analytics-action="click"
                    data-analytics-label={cat.id}
                  >
                    {cat.label}
                  </a>
                ))}
                <span class="site-nav-dropdown-link site-nav-placeholder" aria-disabled="true">
                  Toeslagen (binnenkort)
                </span>
              </div>
            </div>
          </div>

          <div class="site-nav-dropdown" data-nav="categories">
            <button
              type="button"
              class="site-nav-dropdown-toggle"
              id="catDropdownToggle"
              aria-expanded="false"
              aria-controls="catDropdownMenu"
              aria-haspopup="menu"
              data-analytics="header-dropdown-toggle"
              data-analytics-category="header"
              data-analytics-action="click"
              data-analytics-label="categories"
            >
              Categorieën
            </button>
            <div
              class="site-nav-dropdown-menu"
              id="catDropdownMenu"
              role="menu"
              aria-label="Categorieën submenu"
            >
              {categoryList.map((cat) => (
                <a
                  href={cat.href}
                  class="site-nav-dropdown-link"
                  aria-current={isCurrentPage(cat.href) ? "page" : undefined}
                  data-analytics="header-link"
                  data-analytics-category="header"
                  data-analytics-action="click"
                  data-analytics-label={cat.id}
                >
                  {cat.label}
                </a>
              ))}
              <span class="site-nav-dropdown-link site-nav-placeholder" aria-disabled="true">
                Toeslagen (binnenkort)
              </span>
            </div>
          </div>

          <span class="site-nav-link site-nav-placeholder" aria-disabled="true">
            Kennisbank (binnenkort)
          </span>

          <a
            href="/over-ons/"
            class="site-nav-link"
            aria-current={isCurrentPage("/over-ons/") ? "page" : undefined}
            data-analytics="header-link"
            data-analytics-category="header"
            data-analytics-action="click"
            data-analytics-label="over"
          >
            Over
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot name="hero" />
      <div class={containerClass}>
        <slot />
      </div>
    </main>
    <footer>
      <div class="container footer-grid">
        <div class="footer-col">
          <h3 class="footer-title">Calculators</h3>
          <div class="footer-links">
            <a
              href="/calculators/"
              aria-current={isCurrentPage("/calculators/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="popular-calculators"
            >
              Populaire calculators
            </a>
            <a
              href="/calculators/"
              aria-current={isCurrentPage("/calculators/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="new-calculators"
            >
              Nieuw
            </a>
            <span class="footer-placeholder" aria-disabled="true">
              Calculator Explorer (binnenkort)
            </span>
          </div>
        </div>
        <div class="footer-col">
          <h3 class="footer-title">Categorieën</h3>
          <div class="footer-links">
            {categoryList.map((cat) => (
              <a
                href={cat.href}
                aria-current={isCurrentPage(cat.href) ? "page" : undefined}
                data-analytics="footer-link"
                data-analytics-category="footer"
                data-analytics-action="click"
                data-analytics-label={cat.id}
              >
                {cat.label}
              </a>
            ))}
            <span class="footer-placeholder" aria-disabled="true">
              Toeslagen (binnenkort)
            </span>
          </div>
        </div>
        <div class="footer-col">
          <h3 class="footer-title">Informatie</h3>
          <div class="footer-links">
            <span class="footer-placeholder" aria-disabled="true">
              Kennisbank (binnenkort)
            </span>
            <span class="footer-placeholder" aria-disabled="true">
              Nieuws (binnenkort)
            </span>
          </div>
        </div>
        <div class="footer-col">
          <h3 class="footer-title">Bedrijf</h3>
          <div class="footer-links">
            <a
              href="/over-ons/"
              aria-current={isCurrentPage("/over-ons/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="over-ons"
            >
              Over ons
            </a>
            <a
              href="/contact/"
              aria-current={isCurrentPage("/contact/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="contact"
            >
              Contact
            </a>
            <a
              href="/privacy/"
              aria-current={isCurrentPage("/privacy/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="privacy"
            >
              Privacy
            </a>
            <a
              href="/cookies/"
              aria-current={isCurrentPage("/cookies/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="cookies"
            >
              Cookies
            </a>
            <a
              href="/disclaimer/"
              aria-current={isCurrentPage("/disclaimer/") ? "page" : undefined}
              data-analytics="footer-link"
              data-analytics-category="footer"
              data-analytics-action="click"
              data-analytics-label="disclaimer"
            >
              Disclaimer
            </a>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Calculatieloket.nl &mdash; Snelle, duidelijke online calculators &middot; Gebaseerd op officiële bronnen</p>
      </div>
    </footer>
    <CookieConsent />

    <script>
      const toggle = document.getElementById("siteNavToggle") as HTMLButtonElement | null;
      const menu = document.getElementById("siteNavMenu") as HTMLElement | null;
      const dropdowns = document.querySelectorAll(".site-nav-dropdown");
      const dropdownToggles = document.querySelectorAll(".site-nav-dropdown-toggle");

      function closeAllDropdowns() {
        dropdowns.forEach((dropdown) => {
          dropdown.classList.remove("is-open");
          const t = dropdown.querySelector(".site-nav-dropdown-toggle") as HTMLButtonElement | null;
          if (t) t.setAttribute("aria-expanded", "false");
        });
      }

      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          const open = !expanded;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Menu sluiten" : "Menu openen");
          toggle.classList.toggle("is-open", open);
          menu.classList.toggle("is-open", open);
          if (!open) closeAllDropdowns();
        });

        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            toggle.setAttribute("aria-expanded", "false");
            toggle.setAttribute("aria-label", "Menu openen");
            toggle.classList.remove("is-open");
            menu.classList.remove("is-open");
            closeAllDropdowns();
          });
        });
      }

      dropdownToggles.forEach((dropdownToggle) => {
        dropdownToggle.addEventListener("click", (e) => {
          e.stopPropagation();
          const parent = dropdownToggle.closest(".site-nav-dropdown") as HTMLElement;
          const expanded = dropdownToggle.getAttribute("aria-expanded") === "true";
          const open = !expanded;
          if (open) {
            closeAllDropdowns();
          }
          parent.classList.toggle("is-open", open);
          dropdownToggle.setAttribute("aria-expanded", String(open));
        });
      });

      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        const insideDropdown = Array.from(dropdowns).some((d) => d.contains(target));
        if (!insideDropdown) closeAllDropdowns();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if (toggle && menu && toggle.getAttribute("aria-expanded") === "true") {
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Menu openen");
          toggle.classList.remove("is-open");
          menu.classList.remove("is-open");
        }
        closeAllDropdowns();
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<style>
  /* ===== HEADER ===== */
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .site-nav-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .site-nav-burger,
  .site-nav-burger::before,
  .site-nav-burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .site-nav-burger {
    position: relative;
  }

  .site-nav-burger::before,
  .site-nav-burger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .site-nav-burger::before {
    top: -6px;
  }

  .site-nav-burger::after {
    top: 6px;
  }

  .site-nav-toggle.is-open .site-nav-burger {
    background: transparent;
  }

  .site-nav-toggle.is-open .site-nav-burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-nav-toggle.is-open .site-nav-burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .site-nav-link,
  .site-nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    line-height: 1.4;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible,
  .site-nav-dropdown-toggle:hover,
  .site-nav-dropdown-toggle:focus-visible {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .site-nav-placeholder {
    color: var(--color-text-muted);
    cursor: default;
    opacity: 0.75;
  }

  .site-nav-placeholder:hover,
  .site-nav-placeholder:focus-visible {
    background: transparent;
    color: var(--color-text-muted);
  }

  .site-nav-dropdown {
    position: relative;
  }

  .site-nav-dropdown-toggle::after {
    content: " ▼";
    font-size: 0.65rem;
    margin-left: 0.25rem;
  }

  .site-nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 180px;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    z-index: 100;
  }

  .site-nav-megamenu {
    display: none;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    min-width: 420px;
    padding: 1rem;
  }

  .megamenu-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .megamenu-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin: 0 0 0.25rem;
    padding: 0 0.25rem;
  }

  .site-nav-dropdown-link {
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav-dropdown-link:hover,
  .site-nav-dropdown-link:focus-visible {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .site-nav-dropdown-link.site-nav-placeholder {
    color: var(--color-text-muted);
    cursor: default;
  }

  .site-nav-dropdown-link.site-nav-placeholder:hover,
  .site-nav-dropdown-link.site-nav-placeholder:focus-visible {
    background: transparent;
    color: var(--color-text-muted);
  }

  @media (min-width: 721px) {
    .site-nav-dropdown:hover .site-nav-dropdown-menu,
    .site-nav-dropdown:focus-within .site-nav-dropdown-menu,
    .site-nav-dropdown.is-open .site-nav-dropdown-menu {
      display: flex;
    }

    .site-nav-dropdown:hover .site-nav-megamenu,
    .site-nav-dropdown:focus-within .site-nav-megamenu,
    .site-nav-dropdown.is-open .site-nav-megamenu {
      display: grid;
    }
  }

  /* ===== FOOTER ===== */
  footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    padding: 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .footer-col {
    text-align: left;
  }

  .footer-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-placeholder {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  .footer-bottom {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 800px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .site-header-inner {
      padding: 0.75rem 1rem;
    }

    .site-nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 1rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      box-shadow: var(--shadow-lg);
      z-index: 100;
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav-link,
    .site-nav-dropdown-toggle {
      padding: 0.75rem 0.5rem;
      justify-content: space-between;
      width: 100%;
    }

    .site-nav-dropdown-toggle {
      display: flex;
    }

    .site-nav-dropdown-menu {
