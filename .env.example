# AdSense publisher ID (ca-pub-XXXXXXXXXXXX)
# Vervang dit met je echte ID zodra je goedgekeurd bent door Google AdSense
PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Cookiebot CMP ID (Google-gecertificeerde CMP voor EER/VK/Zwitserland)
# Maak een gratis account aan op https://usercentrics.com/cookiebot-cmp/
PUBLIC_COOKIEBOT_ID=00000000-0000-0000-0000-000000000000

# Zet op "true" om advertenties te tonen
# Laat op "false" tijdens development
PUBLIC_ADS_ENABLED=false
